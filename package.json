{
  "name": "ai-academy-centro-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "auth:generate": "auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts -y"
  },
  "dependencies": {
    "express": "5.3.0",
    "ejs": "7.0.2",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "better-auth": "1.7.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "@biomejs/biome": "2.6.5",
    "vitest": "5.1.0",
    "@playwright/test": "1.64.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "auth": "1.7.17",
    "@types/node": "24.19.2",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1"
  }
}
