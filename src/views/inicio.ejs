<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" /><title>Task by Academy — Centro de control</title>
<%- include('partials/theme-init') %><%- include('partials/styles') %>
<style>
.control-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:28px;align-items:center;background:linear-gradient(110deg,var(--nav),var(--primary-dark));color:var(--primary-text);border-radius:var(--radius-card);padding:30px 34px;margin-bottom:20px;box-shadow:var(--shadow-2)}.control-hero h2{font-size:25px;line-height:1.2;margin:0 0 8px;letter-spacing:-.025em}.control-hero p{max-width:720px;margin:0;color:color-mix(in srgb,var(--primary-text) 78%,transparent);line-height:1.6}.control-hero-summary{display:flex;align-items:center;gap:20px}.control-hero-number{display:flex;flex-direction:column;min-width:86px}.control-hero-number strong{font-size:38px;line-height:1;font-variant-numeric:tabular-nums}.control-hero-number span{font-size:11px;margin-top:7px;color:color-mix(in srgb,var(--primary-text) 75%,transparent)}.control-hero .btn{white-space:nowrap;background:var(--paper);border-color:var(--paper);color:var(--primary)}
.control-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:20px}.control-kpi{width:100%;min-height:172px;padding:21px;border:1px solid var(--border);border-radius:var(--radius-card);background:var(--paper);box-shadow:var(--shadow-1);color:var(--ink);text-align:left;display:flex;flex-direction:column;align-items:flex-start;gap:10px;transition:transform var(--t-fast) var(--ease),box-shadow var(--t-fast) var(--ease)}.control-kpi:hover{transform:translateY(-2px);box-shadow:var(--shadow-2)}.control-kpi-label{color:var(--muted);font-size:12px;font-weight:700}.control-kpi strong{font-size:34px;line-height:1;font-variant-numeric:tabular-nums;margin-top:auto}.control-kpi p{margin:0;color:var(--muted);font-size:11px;line-height:1.45}.control-kpi-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:var(--radius-control);background:var(--lav);color:var(--primary)}
.control-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(310px,.9fr);gap:20px;margin-bottom:20px}.control-panel{padding:23px;margin:0}.control-panel .sectiontitle{margin-bottom:21px}.control-panel .sectiontitle h2{font-size:18px}.control-project{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:20px;padding:16px 0;border-bottom:1px solid var(--line)}.control-project:first-of-type{padding-top:0}.control-project:last-of-type{border-bottom:0;padding-bottom:0}.control-project-name{font-size:14px;font-weight:780;color:var(--ink);margin:0 0 5px}.control-project-meta,.control-project-hours{margin:0;font-size:11px;color:var(--muted);line-height:1.6}.control-project-hours{color:var(--primary);font-weight:740;margin-top:4px}.control-project-progress{align-self:center}.control-project-progress strong{display:block;font-size:13px;text-align:right;margin-bottom:7px;font-variant-numeric:tabular-nums}.control-project-progress .bar{margin:0;height:9px}.control-priority{display:flex;gap:12px;padding:15px 0;border-bottom:1px solid var(--line);align-items:flex-start}.control-priority:last-child{border-bottom:0;padding-bottom:0}.control-priority-icon{flex:0 0 auto;width:38px;height:38px;border-radius:var(--radius-control);display:grid;place-items:center;background:var(--redlight);color:var(--red)}.control-priority-icon.high{background:var(--orangelight);color:var(--orange)}.control-priority-body{min-width:0}.control-priority-title{display:block;font-size:12px;font-weight:760;color:var(--ink);margin-bottom:3px}.control-priority-meta{font-size:10.5px;color:var(--muted);line-height:1.55}.control-empty{color:var(--muted);font-size:12px;margin:0;padding:24px 0;text-align:center}
.control-modal-trigger{border:0;font:inherit}@media (max-width:1100px){.control-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.control-grid{grid-template-columns:1fr}}@media (max-width:650px){.control-hero{grid-template-columns:1fr;padding:24px}.control-hero-summary{justify-content:space-between}.control-kpis{grid-template-columns:1fr}.control-project{grid-template-columns:1fr}.control-project-progress{width:100%}.control-project-progress strong{text-align:left}.control-panel{padding:19px}}
</style>
</head>
<body><div class="app"><%- include('partials/sidebar', { active: 'inicio', user }) %><main class="content">
<%- include('partials/navbar', { active: 'inicio', actions: [{ label: 'Crear tarea', href: '/tareas/nueva', icon: 'plus', showLabel: true }, { label: 'Nuevo proyecto', href: '/proyectos/nuevo', variant: 'subtle' }, { label: 'Plan semanal', href: '/planeacion', variant: 'subtle', icon: 'calendar', showLabel: true }] }) %>
<header class="topbar"><div><h1 class="page-title">Centro de control</h1><p class="subtitle">Proyectos, tareas, responsables, entregables y horas de AI Academy en un solo lugar.</p></div></header>
<section class="control-hero" aria-labelledby="control-hero-title"><div><h2 id="control-hero-title">Planificá, entregá y validá con claridad</h2><p>Las tareas avanzan cuando se revisan. Compará lo presupuestado con las horas registradas y mantené el trabajo del equipo visible.</p></div><div class="control-hero-summary"><div class="control-hero-number"><strong><%= activeProjects %></strong><span>Proyectos activos</span></div><a href="/proyectos" class="btn">Ver proyectos <%- include('partials/icon', { kind: 'chevron-right', size: 15 }) %></a></div></section>
<section class="control-kpis" aria-label="Indicadores principales"><button type="button" class="control-kpi control-modal-trigger" onclick="document.getElementById('modal-kpi-proyectos').classList.add('open')"><span class="control-kpi-icon"><%- include('partials/icon', { kind: 'folder', size: 19 }) %></span><span class="control-kpi-label">Proyectos activos</span><strong><%= activeProjects %></strong><p>En toda la organización</p></button><button type="button" class="control-kpi control-modal-trigger" onclick="document.getElementById('modal-kpi-mis-activas').classList.add('open')"><span class="control-kpi-icon"><%- include('partials/icon', { kind: 'check', size: 19 }) %></span><span class="control-kpi-label">Mis tareas activas</span><strong><%= myActiveTasks %></strong><p>Activas o en revisión, a tu cargo</p></button><button type="button" class="control-kpi control-modal-trigger" onclick="document.getElementById('modal-kpi-mis-vencidas').classList.add('open')"><span class="control-kpi-icon"><%- include('partials/icon', { kind: 'clock', size: 19 }) %></span><span class="control-kpi-label">Mis tareas vencidas</span><strong><%= myOverdueTasks %></strong><p><%= myOverdueTasks === 0 ? 'Todo al día' : 'Pasaron la fecha de vencimiento' %></p></button><div class="control-kpi"><span class="control-kpi-icon"><%- include('partials/icon', { kind: 'chart', size: 19 }) %></span><span class="control-kpi-label">Horas confirmadas esta semana</span><strong><%= confirmedWeekHours %> h</strong><p><%= completedTasks %> tareas finalizadas · <%= urgentOrOverdueTasks %> requieren seguimiento</p></div></section>
<% [{ id: 'modal-kpi-proyectos', title: 'Proyectos activos', rows: kpiProjects },{ id: 'modal-kpi-mis-activas', title: 'Mis tareas activas', rows: kpiMyActiveProjects },{ id: 'modal-kpi-mis-vencidas', title: 'Mis tareas vencidas', rows: kpiMyOverdueProjects }].forEach(function(m) { %><div class="modal" id="<%= m.id %>"><div class="modal-backdrop" onclick="document.getElementById('<%= m.id %>').classList.remove('open')"></div><div class="modal-panel"><div class="drawer-header" style="padding:0 0 16px"><h2><%= m.title %></h2><button type="button" class="drawer-close" aria-label="Cerrar" onclick="document.getElementById('<%= m.id %>').classList.remove('open')"><%- include('partials/icon', { kind: 'x', size: 18 }) %></button></div><% if (m.rows.length === 0) { %><%- include('partials/empty-state', { text: 'Nada para mostrar.' }) %><% } else { %><div class="table-wrap"><table class="table"><thead><tr><th>Proyecto</th><th>Responsable</th></tr></thead><tbody><% m.rows.forEach(function(r) { %><tr><td><%= r.code ? r.code + ' — ' + r.name : r.name %></td><td><%= r.leaderName || '—' %></td></tr><% }) %></tbody></table></div><% } %></div></div><% }) %>
<section class="control-grid"><section class="card control-panel" aria-labelledby="project-progress-title"><div class="sectiontitle"><h2 id="project-progress-title">Avance de proyectos</h2><a class="btn" href="/proyectos">Ver todos</a></div><% if (projectProgress.length === 0) { %><p class="control-empty">Todavía no hay proyectos activos.</p><% } %><% projectProgress.forEach(function(project) { %><article class="control-project"><div><h3 class="control-project-name"><%= project.code %> · <%= project.name %></h3><p class="control-project-meta"><%= project.doneCount %> de <%= project.taskCount %> tareas aprobadas · <%= project.completedWeight %>/<%= project.totalWeight %> puntos</p><p class="control-project-hours"><%= project.loggedHours %> h registradas · <%= project.estimatedHours %> h presupuestadas</p></div><div class="control-project-progress"><strong><%= project.progress %>% ponderado</strong><div class="bar"><span style="width:<%= project.progress %>%"></span></div></div></article><% }) %></section><aside class="card control-panel" aria-labelledby="priority-title"><div class="sectiontitle"><h2 id="priority-title">Atención prioritaria</h2><a class="btn" href="/mis-tareas?estado=urgentes">Abrir mis tareas</a></div><% if (priorityTasks.length === 0) { %><p class="control-empty">No tenés tareas pendientes de atención.</p><% } %><% priorityTasks.forEach(function(task) { %><a class="control-priority" href="/tareas/<%= task.id %>"><span class="control-priority-icon <%= task.priority === 'alta' ? 'high' : '' %>"><%- include('partials/icon', { kind: 'clock', size: 18 }) %></span><span class="control-priority-body"><span class="control-priority-title"><%= task.title %></span><span class="control-priority-meta"><%= task.projectName %> · Vence <%= task.due %> · <%= task.status %></span></span></a><% }) %></aside></section>
</main></div></body></html>
