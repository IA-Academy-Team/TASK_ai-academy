<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Inicio</title>
<%- include('partials/theme-init') %>
<%- include('partials/styles') %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'inicio', user }) %>
  <main class="content">
    <%- include('partials/navbar', { active: 'inicio', actions: [{ label: 'Crear tarea', href: '/tareas/nueva', icon: 'plus' }, { label: 'Notificaciones', href: '/notificaciones', variant: 'subtle', icon: 'bell' }] }) %>
    <div class="topbar">
      <div>
        <h1 class="page-title">Hola, <%= user.name || user.email %></h1>
        <p class="subtitle">Resumen de tu actividad en Task.</p>
      </div>
    </div>

    <div class="kpi-row">
      <div class="card kpi card--interactive" onclick="document.getElementById('modal-kpi-proyectos').classList.add('open')">
        <span class="kpi-icon"><%- include('partials/icon', { kind: 'folder', size: 18 }) %></span>
        <small>Proyectos activos</small>
        <strong><%= activeProjects %></strong>
        <p>En toda la organización</p>
      </div>
      <div class="card kpi card--interactive" onclick="document.getElementById('modal-kpi-mis-activas').classList.add('open')">
        <span class="kpi-icon"><%- include('partials/icon', { kind: 'check', size: 18 }) %></span>
        <small>Mis tareas activas</small>
        <strong><%= myActiveTasks %></strong>
        <p>Activas o en revisión, a tu cargo</p>
      </div>
      <div class="card kpi card--interactive <%= myOverdueTasks === 0 ? 'kpi-positive' : '' %>" onclick="document.getElementById('modal-kpi-mis-vencidas').classList.add('open')">
        <span class="kpi-icon"><%- include('partials/icon', { kind: 'clock', size: 18 }) %></span>
        <small>Mis tareas vencidas</small>
        <strong><%= myOverdueTasks %></strong>
        <p><%= myOverdueTasks === 0 ? 'Todo al día' : 'Pasaron la fecha de vencimiento' %></p>
      </div>
    </div>

    <% [
      { id: 'modal-kpi-proyectos', title: 'Proyectos activos', rows: kpiProjects },
      { id: 'modal-kpi-mis-activas', title: 'Mis tareas activas', rows: kpiMyActiveProjects },
      { id: 'modal-kpi-mis-vencidas', title: 'Mis tareas vencidas', rows: kpiMyOverdueProjects },
    ].forEach(function(m) { %>
    <div class="modal" id="<%= m.id %>">
      <div class="modal-backdrop" onclick="document.getElementById('<%= m.id %>').classList.remove('open')"></div>
      <div class="modal-panel">
        <div class="drawer-header" style="padding:0 0 16px">
          <h2><%= m.title %></h2>
          <button type="button" class="drawer-close" aria-label="Cerrar" onclick="document.getElementById('<%= m.id %>').classList.remove('open')"><%- include('partials/icon', { kind: 'x', size: 18 }) %></button>
        </div>
        <% if (m.rows.length === 0) { %>
        <%- include('partials/empty-state', { text: 'Nada para mostrar.' }) %>
        <% } else { %>
        <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Proyecto</th><th>Responsable</th></tr></thead>
          <tbody>
            <% m.rows.forEach(function(r) { %>
            <tr><td><%= r.code ? r.code + ' — ' + r.name : r.name %></td><td><%= r.leaderName || '—' %></td></tr>
            <% }) %>
          </tbody>
        </table>
        </div>
        <% } %>
      </div>
    </div>
    <% }) %>

    <div class="chart-row">
      <section class="card pad">
        <div class="sectiontitle"><h2>Tareas por estado</h2></div>
        <% if (Object.keys(statusCounts).length === 0) { %>
        <%- include('partials/empty-state', { text: 'Todavía no hay tareas registradas.' }) %>
        <% } else { %>
        <div class="chart-wrap chart-wrap-donut"><canvas id="chart-status" role="img" aria-label="Distribución de tareas por estado"></canvas></div>
        <% } %>
      </section>
      <section class="card pad">
        <div class="sectiontitle"><h2>Horas registradas (14 días)</h2></div>
        <% if (!hoursChart.values.some(function(v) { return v > 0; })) { %>
        <%- include('partials/empty-state', { text: 'Sin horas registradas en este período.' }) %>
        <% } else { %>
        <div class="chart-wrap"><canvas id="chart-hours" role="img" aria-label="Horas registradas por día en los últimos 14 días"></canvas></div>
        <% } %>
      </section>
    </div>

    <section class="card pad">
      <div class="sectiontitle"><h2>Actividad reciente</h2></div>
      <% if (activity.length === 0) { %>
      <%- include('partials/empty-state', { text: 'Todavía no hay actividad registrada.' }) %>
      <% } else { %>
      <% activity.forEach(function(a) { %>
      <div class="feed">
        <span class="dot"><%- include('partials/icon', { kind: a.icon }) %></span>
        <div>
          <strong><%= a.text %></strong>
          <p><%= a.when %></p>
        </div>
      </div>
      <% }) %>
      <% } %>
    </section>
  </main>
</div>
<script src="/static/vendor/chart.js"></script>
<script src="/static/js/charts.js"></script>
<script>
(function () {
  var statusCanvas = document.getElementById('chart-status');
  if (statusCanvas && window.AIAcademyCharts) {
    window.AIAcademyCharts.doughnutByStatus(statusCanvas, <%- JSON.stringify(statusCounts) %>);
  }
  var hoursCanvas = document.getElementById('chart-hours');
  if (hoursCanvas && window.AIAcademyCharts) {
    window.AIAcademyCharts.areaSeries(
      hoursCanvas,
      <%- JSON.stringify(hoursChart.labels) %>,
      <%- JSON.stringify(hoursChart.values) %>
    );
  }
})();
</script>
</body>
</html>
