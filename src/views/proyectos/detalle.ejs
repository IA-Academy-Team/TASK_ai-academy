<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — <%= project.name %></title>
<%- include('../partials/theme-init') %>
<%- include('../partials/styles') %>
</head>
<body>
<div class="app">
  <%- include('../partials/sidebar', { active: 'proyectos', user }) %>
  <main class="content">
    <%- include('../partials/navbar', { active: 'proyectos', crumbs: [{ label: project.name }] }) %>
    <div class="topbar">
      <div>
        <span class="flag"><%= project.code %></span>
        <h1 class="page-title"><%= project.name %></h1>
        <p class="subtitle"><%= project.objective %></p>
      </div>
      <div class="topbar-side">
        <div class="muted small" title="Tope simultáneo de tareas por estado, configurable en Configuración del proyecto">
          Límite simultáneo: Activas <%= activeCount %>/<%= project.limitActive %> ·
          En revisión <%= reviewCount %>/<%= project.limitReview %> ·
          Vence <%= project.due %>
        </div>
        <div style="display:flex;gap:8px">
          <% if (isLeaderOrAdmin) { %>
          <button type="button" class="btn" onclick="document.getElementById('modal-carga-masiva').classList.add('open')"><%- include('../partials/icon', { kind: 'upload', size: 14 }) %>Carga masiva</button>
          <button type="button" class="btn primary" onclick="document.getElementById('drawer-nueva-tarea').classList.add('open')"><%- include('../partials/icon', { kind: 'plus', size: 14 }) %>Nueva tarea</button>
          <a class="btn" href="/proyectos/<%= project.id %>/configuracion"><%- include('../partials/icon', { kind: 'settings', size: 14 }) %>Configuración</a>
          <% } %>
        </div>
      </div>
    </div>

    <% if (error) { %><div class="error"><%= error %></div><% } %>

    <div class="modal" id="modal-carga-masiva">
      <div class="modal-backdrop" onclick="location.href='/proyectos/<%= project.id %>'"></div>
      <div class="modal-panel modal-panel-wide">
        <div class="drawer-header" style="padding:0 0 16px">
          <h2>Carga masiva de tareas</h2>
          <button type="button" class="drawer-close" aria-label="Cerrar" onclick="document.getElementById('modal-carga-masiva').classList.remove('open')"><%- include('../partials/icon', { kind: 'x', size: 18 }) %></button>
        </div>
        <p class="subtitle">
          Subí un archivo .xlsx con una tarea por fila. El responsable y el apoyo se identifican por email.
        </p>
        <a class="btn subtle" style="width:100%;justify-content:center;margin-bottom:12px" href="/proyectos/<%= project.id %>/tareas/plantilla.xlsx" download><%- include('../partials/icon', { kind: 'download', size: 14 }) %>Descargar plantilla</a>
        <form id="form-carga-masiva-tareas" method="post" action="/proyectos/<%= project.id %>/tareas/importar" enctype="multipart/form-data" class="form-grid">
          <div class="field full">
            <label>Archivo .xlsx *</label>
            <label class="dropzone" id="dropzone-carga-masiva-tareas">
              <%- include('../partials/icon', { kind: 'upload', size: 20 }) %>
              <span class="dropzone-text" id="dropzone-text-tareas">Arrastrá tu archivo .xlsx acá o hacé clic para buscarlo</span>
              <input type="file" id="file-carga-masiva-tareas" name="file" accept=".xlsx" required />
            </label>
          </div>
          <div class="foot-actions full">
            <button type="button" class="btn" onclick="document.getElementById('modal-carga-masiva').classList.remove('open')">Cancelar</button>
            <button type="submit" class="btn primary" id="btn-importar-tareas">Importar</button>
          </div>
        </form>
      </div>
    </div>
    <script>
    (function () {
      var dz = document.getElementById('dropzone-carga-masiva-tareas');
      var input = document.getElementById('file-carga-masiva-tareas');
      var text = document.getElementById('dropzone-text-tareas');
      var form = document.getElementById('form-carga-masiva-tareas');
      var btn = document.getElementById('btn-importar-tareas');
      var defaultText = text.textContent;
      function updateText() {
        text.textContent = input.files.length ? input.files[0].name : defaultText;
        dz.classList.toggle('has-file', input.files.length > 0);
      }
      input.addEventListener('change', updateText);
      dz.addEventListener('dragover', function (e) { e.preventDefault(); dz.classList.add('dragover'); });
      dz.addEventListener('dragleave', function () { dz.classList.remove('dragover'); });
      dz.addEventListener('drop', function (e) {
        e.preventDefault();
        dz.classList.remove('dragover');
        if (e.dataTransfer.files.length) {
          input.files = e.dataTransfer.files;
          updateText();
        }
      });
      form.addEventListener('submit', function () {
        btn.disabled = true;
        btn.textContent = 'Importando…';
      });
    })();
    </script>

    <div class="drawer" id="drawer-nueva-tarea">
      <div class="drawer-backdrop" onclick="document.getElementById('drawer-nueva-tarea').classList.remove('open')"></div>
      <div class="drawer-panel">
        <div class="drawer-header">
          <h2>Nueva tarea</h2>
          <button type="button" class="drawer-close" aria-label="Cerrar" onclick="document.getElementById('drawer-nueva-tarea').classList.remove('open')"><%- include('../partials/icon', { kind: 'x', size: 18 }) %></button>
        </div>
        <form method="post" action="/tareas" class="drawer-body">
          <input type="hidden" name="projectId" value="<%= project.id %>" />

          <div class="drawer-section">
            <h3>Información</h3>
            <div class="form-grid">
              <div class="field full"><label>Título *</label><input name="title" maxlength="200" required /></div>
              <div class="field full"><label>Entregable esperado *</label><input name="deliverable" maxlength="300" required /></div>
              <div class="field full"><label>Descripción</label><textarea name="description" maxlength="2000"></textarea></div>
            </div>
          </div>

          <div class="drawer-section">
            <h3>Asignación</h3>
            <div class="form-grid">
              <div class="field full"><label>Responsable *</label>
                <select name="ownerId" required>
                  <% allUsers.forEach(function(u) { %><option value="<%= u.id %>"><%= u.name %></option><% }) %>
                </select>
              </div>
              <div class="field full"><label>Apoyo</label>
                <div class="people-grid">
                  <% allUsers.forEach(function(u) { %>
                  <label class="person-chip">
                    <input type="checkbox" name="support" value="<%= u.id %>" />
                    <span class="chip-avatar" style="background:<%= u.color || '#7346CC' %>;color:#fff"><%= (u.name || '?').charAt(0).toUpperCase() %></span>
                    <%= u.name %>
                  </label>
                  <% }) %>
                </div>
              </div>
              <div class="field full"><label>Prioridad *</label>
                <select name="priority" required>
                  <option value="baja">Baja</option>
                  <option value="media" selected>Media</option>
                  <option value="alta">Alta</option>
                  <option value="critica">Crítica</option>
                </select>
              </div>
            </div>
          </div>

          <div class="drawer-section">
            <h3>Planificación</h3>
            <div class="form-grid">
              <div class="field"><label>Horas estimadas *</label><input type="number" name="estimate" min="0.5" max="16" step="0.5" required /></div>
              <div class="field full"><label>Fecha límite *</label><input type="date" name="due" required /></div>
              <div class="field full"><label>Hora de entrega *</label><input type="time" name="dueTime" min="08:00" max="18:00" required /><p class="task-helper">Jornada: 08:00–12:00 y 14:00–18:00.</p></div>
              <div class="field full"><label>Depende de</label>
                <select name="dependencyId">
                  <option value="">Ninguna</option>
                  <% allTasks.forEach(function(t) { %><option value="<%= t.id %>">#<%= t.order %> <%= t.title %></option><% }) %>
                </select>
              </div>
            </div>
          </div>

          <div class="foot-actions">
            <button type="button" class="btn" onclick="document.getElementById('drawer-nueva-tarea').classList.remove('open')">Cancelar</button>
            <button type="submit" class="btn primary">Crear tarea</button>
          </div>
        </form>
      </div>
    </div>

    <%
      function estadoHref(e) {
        var qs = [];
        if (e) qs.push('estado=' + e);
        responsable.forEach(function(id) { qs.push('responsable=' + id); });
        return '/proyectos/' + project.id + (qs.length ? '?' + qs.join('&') : '');
      }
    %>
    <div class="filters">
      <a href="<%= estadoHref(null) %>" class="<%= !estado ? 'on' : '' %>">Todas</a>
      <a href="<%= estadoHref('pendiente') %>" class="<%= estado === 'pendiente' ? 'on' : '' %>">Pendiente</a>
      <a href="<%= estadoHref('activa') %>" class="<%= estado === 'activa' ? 'on' : '' %>">Activa</a>
      <a href="<%= estadoHref('revision') %>" class="<%= estado === 'revision' ? 'on' : '' %>">Revisión</a>
      <a href="<%= estadoHref('completada') %>" class="<%= estado === 'completada' ? 'on' : '' %>">Completada</a>
      <a href="<%= estadoHref('bloqueada') %>" class="<%= estado === 'bloqueada' ? 'on' : '' %>">Bloqueada</a>
    </div>

    <section class="card pad">
      <form method="get" action="/proyectos/<%= project.id %>" class="people-load-row" id="form-carga-por-persona">
        <% if (estado) { %><input type="hidden" name="estado" value="<%= estado %>" /><% } %>
        <label class="person-load-chip <%= responsable.length === 0 ? 'on' : '' %>">
          <input type="checkbox" name="__todos" style="display:none" <%= responsable.length === 0 ? 'checked' : '' %> onclick="document.querySelectorAll('#form-carga-por-persona input[name=responsable]').forEach(function(cb){cb.checked=false}); this.form.submit()" />
          <span class="chip-avatar">·</span>Todos
        </label>
        <% peopleLoad.forEach(function(p) { %>
        <label class="person-load-chip <%= responsable.includes(p.id) ? 'on' : '' %>" title="<%= p.taskCount %> tareas abiertas · <%= p.openHours %> h declaradas">
          <input type="checkbox" name="responsable" value="<%= p.id %>" style="display:none" <%= responsable.includes(p.id) ? 'checked' : '' %> onchange="this.form.submit()" />
          <span class="chip-avatar" style="--chip-bg:<%= p.color || '#7346CC' %>;--chip-fg:#fff"><%= (p.name || '?').charAt(0).toUpperCase() %></span>
          <%= p.name %><% if (p.isLeader) { %> · líder<% } %>
          <strong><%= p.taskCount %></strong><small>· <%= p.openHours %> h</small>
        </label>
        <% }) %>
      </form>
    </section>

    <section class="card pad">
      <% if (tasks.length === 0) { %>
      <%- include('../partials/empty-state', { text: 'Sin tareas en esta vista.' }) %>
      <% } else { %>
      <div class="table-wrap">
      <table class="table">
        <thead><tr><th>#</th><th>Tarea</th><th>Responsable</th><th>Prioridad</th><th>Estado</th><th>Vence</th><th></th></tr></thead>
        <tbody>
          <% tasks.forEach(function(t) { %>
          <tr onclick="location.href='/tareas/<%= t.id %>'" style="cursor:pointer">
            <td><%= t.order %></td>
            <td><strong><%= t.title %></strong><br/><small class="muted"><%= t.deliverable %></small></td>
            <td><% const owner = allUsers.find(function(u){ return u.id === t.ownerId }); %><%= owner ? owner.name : t.ownerId %></td>
            <td><span class="badge <%= t.priority %>"><%= t.priority %></span></td>
            <td><span class="badge <%= t.status %>"><%= t.status %></span></td>
            <td><%= t.due %></td>
            <td><% if (supportTaskIdsForUser.has(t.id)) { %><span title="Sos apoyo en esta tarea"><%- include('../partials/icon', { kind: 'handshake', size: 14 }) %></span><% } %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </section>

  </main>
</div>
<script>
  if (sessionStorage.getItem('aiacademy-project-create-submitted') === '1') {
    localStorage.removeItem('aiacademy-project-create-draft');
    sessionStorage.removeItem('aiacademy-project-create-submitted');
  }
</script>
</body>
</html>
