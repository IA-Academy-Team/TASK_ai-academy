<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Proyectos</title>
<%- include('../partials/theme-init') %>
<%- include('../partials/styles') %>
<style>
.project-list-grid{grid-template-columns:repeat(auto-fill,minmax(330px,1fr));align-items:stretch}.project-card{min-height:374px;padding:20px;border-left-width:1px}.project-card .meta{justify-content:flex-start;gap:13px}.project-card .meta span{white-space:nowrap}.project-card-new{min-height:374px;border:1px dashed var(--accent);background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;color:var(--primary)}.project-card-new h2{margin:13px 0 6px;font-size:17px;color:var(--ink)}.project-card-new p{margin:0 0 18px;max-width:280px;color:var(--muted);font-size:11px;line-height:1.55}.project-card-new-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:999px;background:var(--lav);font-size:22px}.project-card-new .btn{color:var(--primary);background:var(--lav);border-color:var(--lav)}@media (max-width:700px){.project-list-grid{grid-template-columns:1fr}.project-card,.project-card-new{min-height:auto}}
.project-filter-box{display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:14px;padding:14px;border:1px solid var(--line);border-radius:var(--radius-control);background:var(--bg);margin-bottom:16px}.project-filter-fields{display:flex;align-items:flex-end;flex-wrap:wrap;gap:10px}.project-filter-fields .field{margin:0}.project-filter-label{display:block;margin:0 0 7px;font-size:10px;font-weight:800;color:var(--muted);letter-spacing:.04em;text-transform:uppercase}.project-filter-fields input[type=text]{min-height:36px;font-size:11px;width:200px}.project-filter-fields select{min-height:36px;font-size:11px;width:180px}.project-filter-chips{display:flex;flex-wrap:wrap;gap:7px}.project-filter-chips a{display:inline-flex;align-items:center;padding:9px 10px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--text);font-size:10px;font-weight:730}.project-filter-chips a.on{background:var(--primary);border-color:var(--primary);color:var(--primary-text)}@media (max-width:900px){.project-filter-box{align-items:stretch;flex-direction:column}.project-filter-fields input[type=text],.project-filter-fields select{width:100%}}
</style>
</head>
<body>
<div class="app">
  <%- include('../partials/sidebar', { active: 'proyectos', user }) %>
  <main class="content">
    <%
      var projectsNavActions = [{ label: 'Crear tarea', href: '/tareas/nueva', variant: 'subtle', icon: 'plus' }];
      if (user.role === "administrador") {
        projectsNavActions.push({ label: 'Carga masiva', onclick: "document.getElementById('modal-carga-masiva-proyectos').classList.add('open')", variant: 'subtle', icon: 'upload' });
        projectsNavActions.push({ label: 'Crear proyecto', href: '/proyectos/nuevo', icon: 'folder-plus' });
      }
    %>
    <%- include('../partials/navbar', { active: 'proyectos', actions: projectsNavActions }) %>
    <div class="topbar">
      <div>
        <h1 class="page-title">Proyectos</h1>
        <p class="subtitle">Crea proyectos nuevos y abre su lista de tareas ordenadas por dependencias.</p>
      </div>
    </div>

    <% var hasActiveFilters = !!(filters.nombre || filters.responsable || filters.estado); %>
    <% var estadoLinkBase = '/proyectos?nombre=' + encodeURIComponent(filters.nombre) + '&responsable=' + encodeURIComponent(filters.responsable) + '&estado='; %>
    <div class="project-filter-box">
      <form method="get" action="/proyectos" class="project-filter-fields">
        <div class="field">
          <label class="project-filter-label" for="project-filter-nombre">Nombre</label>
          <input type="text" id="project-filter-nombre" name="nombre" value="<%= filters.nombre %>" placeholder="Buscar por nombre..." />
        </div>
        <div class="field">
          <label class="project-filter-label" for="project-filter-responsable">Responsable</label>
          <select id="project-filter-responsable" name="responsable">
            <option value="">Todos</option>
            <% responsableOptions.forEach(function(u) { %><option value="<%= u.id %>" <%= filters.responsable === u.id ? 'selected' : '' %>><%= u.name %></option><% }) %>
          </select>
        </div>
        <input type="hidden" name="estado" value="<%= filters.estado %>" />
        <button type="submit" class="btn subtle">Filtrar</button>
        <% if (hasActiveFilters) { %><a href="/proyectos" class="btn subtle">Limpiar filtros</a><% } %>
      </form>
      <div class="project-filter-chips">
        <a href="<%= estadoLinkBase %>" class="<%= filters.estado === '' ? 'on' : '' %>">Todos</a>
        <a href="<%= estadoLinkBase %>ejecucion" class="<%= filters.estado === 'ejecucion' ? 'on' : '' %>">En ejecución</a>
        <a href="<%= estadoLinkBase %>por-vencer" class="<%= filters.estado === 'por-vencer' ? 'on' : '' %>">Por vencer</a>
        <a href="<%= estadoLinkBase %>vencido" class="<%= filters.estado === 'vencido' ? 'on' : '' %>">Vencido</a>
        <a href="<%= estadoLinkBase %>completado" class="<%= filters.estado === 'completado' ? 'on' : '' %>">Completado</a>
      </div>
    </div>

    <% if (items.length === 0 && hasActiveFilters) { %>
    <div class="card" style="margin-bottom:16px"><%- include('../partials/empty-state', { text: 'Ningún proyecto coincide con ese filtro.' }) %></div>
    <% } %>

    <div class="project-grid project-list-grid">
      <% items.forEach(function(p) { %>
      <a class="card project-card risk-<%= p.risk.level %>" href="/proyectos/<%= p.id %>">
        <div class="project-card-top">
          <span class="flag"><%= p.code %></span>
          <% if (p.risk.level === 'done') { %>
          <span class="badge completada">Completado</span>
          <% } else if (p.risk.level === 'risk') { %>
          <span class="badge <%= p.risk.daysLeft < 0 ? 'bloqueada' : 'alta' %>"><%= p.risk.daysLeft < 0 ? 'Venció' : 'Vence en ' + p.risk.daysLeft + 'd' %></span>
          <% } else { %>
          <span class="badge activa">En ejecución</span>
          <% } %>
        </div>
        <h2><%= p.name %></h2>
        <p><%= p.objective %></p>
        <div class="meta">
          <span>Líder: <%= p.leaderName %></span>
          <span><%= p.members.length %> responsables</span>
          <span><%= p.due %></span>
        </div>
        <div class="bar-row">
          <span><%= p.weightedPct %>% de avance</span>
          <span><%= p.doneCount %>/<%= p.taskCount %> tareas</span>
        </div>
        <div class="bar"><span style="width: <%= p.weightedPct %>%"></span></div>
        <div class="project-hours">
          <small>Horas reales invertidas</small>
          <strong><%= p.stats.logged %> h</strong>
          <p><%= p.budget %> h presupuestadas en el proyecto</p>
          <p><%= p.stats.confirmed %> h aprobadas · <%= p.stats.unconfirmed %> h por validar</p>
        </div>
        <div class="project-card-footer">
          <span>Tiempo reportado por responsable y apoyos</span>
          <span class="project-card-footer-link">Ver detalle →</span>
        </div>
      </a>
      <% }) %>
      <% if (user.role === "administrador") { %>
      <a class="project-card-new" href="/proyectos/nuevo">
        <span class="project-card-new-icon">+</span>
        <h2>Nuevo proyecto</h2>
        <p>Empieza sin tareas y agrégalas una a una desde el proyecto.</p>
        <span class="btn"><%- include('../partials/icon', { kind: 'plus', size: 14 }) %> Crear</span>
      </a>
      <% } %>
    </div>
    <% if (items.length === 0 && !hasActiveFilters && user.role !== "administrador") { %>
    <div class="card" style="margin-top:16px"><%- include('../partials/empty-state', { text: 'Todavía no hay proyectos visibles para vos.' }) %></div>
    <% } %>

    <% if (user.role === "administrador") { %>
    <div class="modal" id="modal-carga-masiva-proyectos">
      <div class="modal-backdrop" onclick="document.getElementById('modal-carga-masiva-proyectos').classList.remove('open')"></div>
      <div class="modal-panel modal-panel-wide">
        <div class="drawer-header" style="padding:0 0 16px">
          <h2>Carga masiva de proyectos</h2>
          <button type="button" class="drawer-close" aria-label="Cerrar" onclick="document.getElementById('modal-carga-masiva-proyectos').classList.remove('open')"><%- include('../partials/icon', { kind: 'x', size: 18 }) %></button>
        </div>
        <p class="subtitle">
          Subí un archivo .xlsx con un proyecto por fila. El líder y los integrantes se identifican por email.
        </p>
        <a class="btn subtle" style="width:100%;justify-content:center;margin-bottom:12px" href="/proyectos/plantilla.xlsx" download><%- include('../partials/icon', { kind: 'download', size: 14 }) %>Descargar plantilla</a>
        <form id="form-carga-masiva-proyectos" method="post" action="/proyectos/importar" enctype="multipart/form-data" class="form-grid">
          <div class="field full">
            <label>Archivo .xlsx *</label>
            <label class="dropzone" id="dropzone-carga-masiva-proyectos">
              <%- include('../partials/icon', { kind: 'upload', size: 20 }) %>
              <span class="dropzone-text" id="dropzone-text-proyectos">Arrastrá tu archivo .xlsx acá o hacé clic para buscarlo</span>
              <input type="file" id="file-carga-masiva-proyectos" name="file" accept=".xlsx" required />
            </label>
          </div>
          <div class="foot-actions full">
            <button type="button" class="btn" onclick="document.getElementById('modal-carga-masiva-proyectos').classList.remove('open')">Cancelar</button>
            <button type="submit" class="btn primary" id="btn-importar-proyectos">Importar</button>
          </div>
        </form>
      </div>
    </div>
    <script>
    (function () {
      var dz = document.getElementById('dropzone-carga-masiva-proyectos');
      var input = document.getElementById('file-carga-masiva-proyectos');
      var text = document.getElementById('dropzone-text-proyectos');
      var form = document.getElementById('form-carga-masiva-proyectos');
      var btn = document.getElementById('btn-importar-proyectos');
      var defaultText = text.textContent;
      function updateText() {
        text.textContent = input.files.length ? input.files[0].name : defaultText;
        dz.classList.toggle('has-file', input.files.length > 0);
      }
      input.addEventListener('change', updateText);
      dz.addEventListener('dragover', function (e) { e.preventDefault(); dz.classList.add('dragover'); });
      dz.addEventListener('dragleave', function () { dz.classList.remove('dragover'); });
      dz.addEventListener('drop', function (e) {
        e.preventDefault();
        dz.classList.remove('dragover');
        if (e.dataTransfer.files.length) {
          input.files = e.dataTransfer.files;
          updateText();
        }
      });
      form.addEventListener('submit', function () {
        btn.disabled = true;
        btn.textContent = 'Importando…';
      });
    })();
    </script>
    <div class="modal <%= openNewProjectModal ? 'open' : '' %>" id="new-project-modal">
      <div class="modal-backdrop" onclick="location.href='/proyectos'"></div>
      <div class="modal-panel modal-panel-wide">
        <div class="drawer-header" style="padding:0 0 16px">
          <h2>Nuevo proyecto</h2>
          <button type="button" class="drawer-close" aria-label="Cerrar" onclick="document.getElementById('new-project-modal').classList.remove('open')"><%- include('../partials/icon', { kind: 'x', size: 18 }) %></button>
        </div>
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <form method="post" action="/proyectos" class="form-grid">
          <input type="hidden" name="limitActive" value="2" />
          <input type="hidden" name="limitReview" value="2" />
          <div class="field full"><label>Nombre del proyecto *</label><input name="name" required /></div>
          <div class="field"><label>Fecha de inicio *</label><input type="date" name="start" required /></div>
          <div class="field"><label>Fecha límite *</label><input type="date" name="due" required /></div>
          <div class="field full"><label>Objetivo *</label><textarea name="objective" required></textarea></div>
          <div class="field full"><label>Líder del proyecto *</label>
            <select name="leaderId" required onchange="onNewProjectLeaderChange(this)">
              <option value="">Selecciona un líder</option>
              <% leaderCandidates.forEach(function(u) { %><option value="<%= u.id %>"><%= u.name %></option><% }) %>
            </select>
          </div>
          <div class="field full">
            <label>Integrantes <span class="muted small">(el líder no cuenta como integrante)</span></label>
            <div class="dropdown-select" id="new-project-members-dropdown">
              <button type="button" class="dropdown-select-trigger" onclick="document.getElementById('new-project-members-dropdown').classList.toggle('open')">
                <span id="new-project-members-label">Selecciona integrantes</span>
                <%- include('../partials/icon', { kind: 'chevron-down', size: 14 }) %>
              </button>
              <div class="dropdown-select-panel people-grid" id="new-project-members">
                <% users.forEach(function(u) { %>
                <label class="person-chip">
                  <input type="checkbox" name="members" value="<%= u.id %>" onchange="updateNewProjectMembersLabel()" />
                  <span class="chip-avatar" style="background:<%= u.color || '#7346CC' %>;color:#fff"><%= (u.name || '?').charAt(0).toUpperCase() %></span>
                  <%= u.name %>
                </label>
                <% }) %>
              </div>
            </div>
          </div>
          <div class="foot-actions full">
            <button type="button" class="btn" onclick="document.getElementById('new-project-modal').classList.remove('open')">Cancelar</button>
            <button type="submit" class="btn primary">Crear proyecto</button>
          </div>
        </form>
      </div>
    </div>
    <% } %>
  </main>
</div>
<script>
function onNewProjectLeaderChange(select) {
  var leaderId = select.value;
  document.querySelectorAll('#new-project-members input[type=checkbox]').forEach(function (cb) {
    var chip = cb.closest('.person-chip');
    if (cb.value === leaderId) {
      cb.checked = false;
      cb.disabled = true;
      chip.classList.add('is-disabled');
    } else {
      cb.disabled = false;
      chip.classList.remove('is-disabled');
    }
  });
  updateNewProjectMembersLabel();
}
function updateNewProjectMembersLabel() {
  var checked = document.querySelectorAll('#new-project-members input[type=checkbox]:checked');
  var label = document.getElementById('new-project-members-label');
  if (!label) return;
  label.textContent = checked.length ? checked.length + ' seleccionados' : 'Selecciona integrantes';
}
document.addEventListener('click', function (e) {
  var dd = document.getElementById('new-project-members-dropdown');
  if (dd && dd.classList.contains('open') && !dd.contains(e.target)) {
    dd.classList.remove('open');
  }
});
</script>
</body>
</html>
