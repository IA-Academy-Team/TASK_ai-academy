<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — <%= task.title %></title>
<%- include('../partials/theme-init') %>
<%- include('../partials/styles') %>
</head>
<body>
<div class="app">
  <%- include('../partials/sidebar', { active: project ? 'proyectos' : 'mis-tareas', user }) %>
  <main class="content">
    <%- include('../partials/navbar', { active: project ? 'proyectos' : 'mis-tareas', crumbs: project ? [{ label: project.name, href: '/proyectos/' + project.id }, { label: task.title }] : [{ label: task.title }] }) %>
    <div class="topbar">
      <div>
        <p class="subtitle"><% if (project) { %><a href="/proyectos/<%= project.id %>">&larr; <%= project.name %></a><% } else { %>Tarea independiente<% } %></p>
        <h1 class="page-title"><% if (project) { %>#<%= task.order %> <% } %><%= task.title %></h1>
        <p class="subtitle"><%= task.deliverable %></p>
      </div>
      <div>
        <span class="badge <%= task.priority %>"><%= task.priority %></span>
        <span class="badge <%= task.status %><%= justUpdated ? ' just-updated' : '' %>">
          <% if (justUpdated && task.status === 'completada') { %><svg class="badge-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 7" /></svg><% } %><%= task.status %>
        </span>
        <% if (isLeaderOrAdmin && task.status !== 'completada' && task.status !== 'cancelada') { %>
        <a class="btn subtle" href="/tareas/<%= task.id %>/editar">Editar</a>
        <% } %>
      </div>
    </div>

    <% if (error) { %><div class="error"><%= error %></div><% } %>

    <div class="form-grid">
      <section class="card pad">
        <div class="sectiontitle"><h2>Detalle</h2></div>
        <% if (task.description) { %><p class="small"><%= task.description %></p><% } %>
        <div class="detail-row"><span>Responsable</span><strong><% const owner = users.find(function(u){return u.id===task.ownerId}); %><%= owner ? owner.name : task.ownerId %></strong></div>
        <div class="detail-row"><span>Apoyo</span><strong><%= support.length ? support.map(function(s){ const u = users.find(function(x){return x.id===s.userId}); return u ? u.name : s.userId }).join(', ') : 'Ninguno' %></strong></div>
        <div class="detail-row"><span>Peso</span><strong><%= task.weight %></strong></div>
        <div class="detail-row"><span>Estimado</span><strong><%= task.estimate %> h</strong></div>
        <div class="detail-row"><span>Horas registradas</span><strong><%= totalHours %> h</strong></div>
        <div class="detail-row"><span>Vence</span><strong><%= task.due %></strong></div>
        <% if (dependency) { %><div class="detail-row"><span>Depende de</span><strong>#<%= dependency.order %> <%= dependency.title %> (<%= dependency.status %>)</strong></div><% } %>
        <% if (task.evidence) { %><div class="detail-row"><span>Evidencia</span><strong><%= task.evidence %></strong></div><% } %>
        <% if (task.approvedAt) { %><div class="detail-row"><span>Aprobada</span><strong><%= task.approvedAt %></strong></div><% } %>

        <div class="sectiontitle" style="margin-top:17px"><h2>Cambiar estado</h2></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <% if (task.status === 'pendiente') { %>
          <form method="post" action="/tareas/<%= task.id %>/estado"><input type="hidden" name="status" value="activa" /><button class="btn primary" type="submit">Iniciar</button></form>
          <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="bloqueada" /><input name="note" placeholder="Motivo" required style="padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn" type="submit">Bloquear</button></form>
          <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="cancelada" /><input name="note" placeholder="Motivo" required style="padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn danger" type="submit">Cancelar</button></form>
          <% } %>
          <% if (task.status === 'activa' && user.id === task.ownerId) { %>
          <a class="btn primary" href="/tareas/<%= task.id %>/entrega">Entregar</a>
          <% } %>
          <% if (task.status === 'activa') { %>
          <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="bloqueada" /><input name="note" placeholder="Motivo" required style="padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn" type="submit">Bloquear</button></form>
          <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="cancelada" /><input name="note" placeholder="Motivo" required style="padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn danger" type="submit">Cancelar</button></form>
          <% } %>
          <% if (task.status === 'revision') { %>
            <% if (isLeaderOrAdmin) { %>
            <form method="post" action="/tareas/<%= task.id %>/estado" onsubmit="return confirm('¿Aprobar esta tarea? Pasa a completada y no se puede deshacer.')">
              <input type="hidden" name="status" value="completada" />
              <% if (!task.evidence) { %><input name="evidence" placeholder="Evidencia" required style="padding:8px;border:1px solid var(--line);border-radius:8px" />&nbsp;<% } %>
              <button class="btn primary" type="submit">Aprobar</button>
            </form>
            <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="activa" /><input name="note" placeholder="Observaciones" required style="padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn" type="submit">Devolver a activa</button></form>
            <% } %>
          <% } %>
          <% if (task.status === 'bloqueada') { %>
          <form method="post" action="/tareas/<%= task.id %>/estado"><input type="hidden" name="status" value="pendiente" /><button class="btn" type="submit">Desbloquear</button></form>
          <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="cancelada" /><input name="note" placeholder="Motivo" required style="padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn danger" type="submit">Cancelar</button></form>
          <% } %>
        </div>
      </section>

      <% if (canRequestSupport) { %>
      <section class="card pad">
        <div class="sectiontitle"><h2>Solicitar apoyo</h2></div>
        <form method="post" action="/tareas/<%= task.id %>/apoyo" class="form-grid">
          <div class="field"><label>Persona *</label>
            <select name="targetUserId" required>
              <% users.filter(function(u){return u.id !== task.ownerId}).forEach(function(u) { %><option value="<%= u.id %>"><%= u.name %></option><% }) %>
            </select>
          </div>
          <div class="field"><label>Modalidad *</label>
            <select name="mode" required>
              <option value="invite">Invitar (la persona acepta)</option>
              <option value="apply">Pedir que el líder la asigne</option>
            </select>
          </div>
          <div class="field full"><label>Motivo</label><input name="reason" maxlength="1000" /></div>
          <div class="foot-actions full"><button type="submit" class="btn primary">Pedir apoyo</button></div>
        </form>
      </section>
      <% } %>

      <section class="card pad">
        <div class="sectiontitle"><h2>Registro de horas</h2></div>
        <% logs.forEach(function(l) { %>
        <div class="detail-row"><span><%= l.date %> (<%= l.role %>)</span><strong><%= l.hours %> h</strong></div>
        <% }) %>
        <% if (isOwnerOrSupport) { %>
        <form method="post" action="/tareas/<%= task.id %>/horas" style="margin-top:14px">
          <div class="field"><label>Fecha</label><input type="date" name="date" required /></div>
          <div class="field"><label>Horas</label><input type="number" name="hours" min="0.5" step="0.5" max="24" required /></div>
          <button class="btn primary" type="submit" style="margin-top:8px">Registrar</button>
        </form>
        <% } %>
      </section>
    </div>

    <section class="card pad">
      <div class="sectiontitle"><h2>Últimos cambios</h2></div>
      <% if (recentChanges.length === 0) { %>
      <%- include('../partials/empty-state', { text: 'Sin cambios registrados.' }) %>
      <% } else { %>
      <div class="feed">
        <% recentChanges.forEach(function(c) { %>
        <div class="detail-row"><span><%= c.actorName %> · <%= c.action %><% if (c.note) { %> · <%= c.note %><% } %></span><strong><%= c.createdAt %></strong></div>
        <% }) %>
      </div>
      <% } %>
      <a class="btn subtle" href="/tareas/<%= task.id %>/auditoria" style="margin-top:10px;display:inline-block">Ver todo</a>
    </section>
  </main>
</div>
</body>
</html>
