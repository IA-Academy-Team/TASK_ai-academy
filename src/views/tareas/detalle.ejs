<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — <%= task.title %></title>
<%- include('../partials/theme-init') %>
<%- include('../partials/styles') %>
<style>
.task-detail-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.9fr);gap:20px;align-items:start}.task-detail-main{padding:0;overflow:hidden}.task-detail-section{padding:20px;border-bottom:1px solid var(--line)}.task-detail-section:last-child{border-bottom:0}.task-detail-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.task-detail-heading h2{font-size:15px;margin:0}.task-detail-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.task-detail-stat{padding:13px;border-radius:var(--radius-control);background:var(--bg)}.task-detail-stat small{display:block;color:var(--muted);font-size:10px;margin-bottom:7px}.task-detail-stat strong{display:block;font-size:14px;line-height:1.35}.task-detail-copy{font-size:12px;line-height:1.65;margin:5px 0 0;color:var(--text)}.task-detail-note{margin-top:14px;padding:11px 13px;border:1px solid var(--line);border-radius:var(--radius-control);background:var(--lav);color:var(--primary);font-size:11px;line-height:1.55}.task-detail-actions{display:flex;flex-wrap:wrap;gap:8px}.task-detail-actions .btn{min-height:40px}.task-detail-side{display:grid;gap:14px}.task-detail-side .card{margin:0}.task-member{display:flex;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--line)}.task-member:last-child{border-bottom:0}.task-member-avatar{width:31px;height:31px;border-radius:999px;display:grid;place-items:center;flex:0 0 auto;background:var(--lav);color:var(--primary);font-size:10px;font-weight:800}.task-member strong,.task-member small{display:block}.task-member strong{font-size:12px}.task-member small{margin-top:2px;color:var(--muted);font-size:10px}.task-history-empty{margin:0;color:var(--muted);font-size:11px;line-height:1.55}.task-hours-list{margin-top:14px}.task-evidence-empty{margin:0;color:var(--muted);font-size:11px;line-height:1.55}@media (max-width:1000px){.task-detail-layout{grid-template-columns:1fr}.task-detail-side{grid-template-columns:1fr 1fr}}@media (max-width:650px){.task-detail-summary,.task-detail-side{grid-template-columns:1fr}.task-detail-section{padding:17px}.task-detail-heading{align-items:flex-start;flex-direction:column}.task-detail-actions .btn{width:100%;justify-content:center}}
</style>
</head>
<body>
<div class="app">
  <%- include('../partials/sidebar', { active: project ? 'proyectos' : 'mis-tareas', user }) %>
  <main class="content">
    <%- include('../partials/navbar', { active: project ? 'proyectos' : 'mis-tareas', crumbs: project ? [{ label: project.name, href: '/proyectos/' + project.id }, { label: task.title }] : [{ label: task.title }] }) %>
    <div class="topbar">
      <div>
        <p class="subtitle"><% if (project) { %><a href="/proyectos/<%= project.id %>">Volver al proyecto</a><% } else { %>Tarea personal<% } %></p>
        <h1 class="page-title"><%= task.title %></h1>
        <p class="subtitle"><%= project ? project.name + ' · ' : '' %>Fecha límite: <%= task.due %><% if (task.dueTime) { %> · <%= task.dueTime %><% } %></p>
      </div>
      <div>
        <span class="badge <%= task.priority %>"><%= task.priority %></span>
        <span class="badge <%= task.status %><%= justUpdated ? ' just-updated' : '' %>">
          <% if (justUpdated && task.status === 'completada') { %><svg class="badge-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 7" /></svg><% } %><%= task.status %>
        </span>
      </div>
    </div>

    <% if (error) { %><div class="error"><%= error %></div><% } %>

    <% const owner = ownerCandidates.find(function(u){ return u.id === task.ownerId; }); %>
    <div class="task-detail-layout">
      <section class="card task-detail-main">
        <div class="task-detail-section">
          <div class="task-detail-heading"><h2>Ficha de la tarea<% if (project) { %> #<%= task.order %><% } %></h2><div><span class="badge <%= task.status %><%= justUpdated ? ' just-updated' : '' %>"><%= task.status %></span> <span class="badge <%= task.priority %>"><%= task.priority %></span></div></div>
          <div class="task-detail-summary"><div class="task-detail-stat"><small>Responsable principal</small><strong><%= owner ? owner.name : task.ownerId %></strong></div><div class="task-detail-stat"><small>Horas presupuestadas</small><strong><%= task.estimate %> h</strong></div><div class="task-detail-stat"><small>Horas declaradas</small><strong><%= totalHours ? totalHours + ' h' : '—' %></strong></div><div class="task-detail-stat"><small>Entrega</small><strong><%= task.due %><% if (task.dueTime) { %> · <%= task.dueTime %><% } %></strong></div></div>
        </div>
        <div class="task-detail-section"><p class="task-preview-project">Entregable que se debe aprobar</p><strong><%= task.deliverable %></strong><% if (task.description) { %><p class="task-detail-copy"><%= task.description %></p><% } %><% if (dependency) { %><p class="task-detail-note">Depende de #<%= dependency.order %> <strong><%= dependency.title %></strong> (<%= dependency.status %>).</p><% } else { %><p class="task-detail-note">Sin dependencia: esta tarea puede realizarse en paralelo.</p><% } %></div>
        <div class="task-detail-section"><div class="task-detail-heading"><h2>Acciones</h2></div><div class="task-detail-actions"><% if (isLeaderOrAdmin && task.status !== 'completada' && task.status !== 'cancelada') { %><a class="btn" href="/tareas/<%= task.id %>/editar"><%- include('../partials/icon', { kind: 'edit', size: 14 }) %> Editar / reprogramar</a><% } %><% if (task.status !== 'completada' && task.status !== 'cancelada') { %><button type="button" class="btn" onclick="document.getElementById('modal-cambiar-estado').classList.add('open')"><%- include('../partials/icon', { kind: 'swap', size: 14 }) %> Cambiar estado</button><% } %><% if (task.status === 'activa' && (user.id === task.ownerId || support.some(function(s){return s.userId === user.id}))) { %><a class="btn primary" href="/tareas/<%= task.id %>/entrega"><%- include('../partials/icon', { kind: 'check', size: 14 }) %> Entregar tarea</a><% } %><% if (canRequestSupport) { %><button type="button" class="btn" onclick="document.getElementById('modal-solicitar-apoyo').classList.add('open')"><%- include('../partials/icon', { kind: 'handshake', size: 14 }) %> Solicitar apoyo</button><% } %><% if (user.id === task.ownerId) { %><button type="button" class="btn" onclick="document.getElementById('modal-registrar-horas').classList.add('open')"><%- include('../partials/icon', { kind: 'clock', size: 14 }) %> Registrar horas</button><% } else if (support.some(function(s){return s.userId === user.id}) && (task.status === 'activa' || task.status === 'revision')) { %><a class="btn" href="/tareas/<%= task.id %>/horas-apoyo"><%- include('../partials/icon', { kind: 'clock', size: 14 }) %> Registrar horas</a><% } %><% if (canDelete) { %><form method="post" action="/tareas/<%= task.id %>/eliminar" onsubmit="return aiacademyConfirmSubmit(this, '¿Eliminar esta tarea? También se borrarán sus horas, apoyo y auditoría.')"><button type="submit" class="btn danger"><%- include('../partials/icon', { kind: 'trash', size: 14 }) %> Eliminar</button></form><% } %></div></div>
        <div class="task-detail-section"><div class="task-detail-heading"><h2>Evidencias y control de entrega</h2></div><% if (task.evidence) { %><p class="task-detail-copy"><strong>Evidencia:</strong> <%= task.evidence %></p><% } else { %><p class="task-evidence-empty">Aún no se ha enviado una entrega. El responsable reportará las horas reales y adjuntará la evidencia al finalizar.</p><% } %><% if (task.approvedAt) { %><p class="task-detail-copy"><strong>Aprobada:</strong> <%= task.approvedAt %></p><% } %><% if (logs.length > 0) { %><div class="task-hours-list"><% logs.forEach(function(l) { %><div class="detail-row"><span><%= l.date %> · <%= l.role === 'owner' ? 'responsable' : 'apoyo' %><% if (l.description) { %> — <%= l.description %><% } %></span><strong><%= l.hours %> h</strong></div><% }) %></div><% } %></div>
      </section>
      <aside class="task-detail-side"><section class="card pad"><div class="task-detail-heading"><h2>Equipo de la tarea</h2></div><div class="task-member"><span class="task-member-avatar"><%= (owner ? owner.name : '?').charAt(0).toUpperCase() %></span><span><strong><%= owner ? owner.name : task.ownerId %></strong><small>Responsable principal · entrega y reporta</small></span></div><% if (support.length) { %><p class="task-preview-project" style="margin:14px 0 0">Apoyos aceptados</p><% support.forEach(function(s) { const member = users.find(function(u){ return u.id === s.userId; }); %><div class="task-member"><span class="task-member-avatar"><%= (member ? member.name : '?').charAt(0).toUpperCase() %></span><span><strong><%= member ? member.name : s.userId %></strong><small>Apoyo de la tarea</small></span></div><% }) %><% } else { %><p class="task-history-empty">No hay apoyos aceptados. El titular continúa siendo una sola persona.</p><% } %></section><section class="card pad"><div class="task-detail-heading"><h2>Historial y cambios</h2><a class="btn subtle" href="/tareas/<%= task.id %>/auditoria">Ver historial</a></div><p class="task-history-empty">Consultá las actualizaciones, reasignaciones y cambios de estado registrados para esta tarea.</p></section></aside>
    </div>

    <div class="modal" id="modal-cambiar-estado">
      <div class="modal-backdrop" onclick="document.getElementById('modal-cambiar-estado').classList.remove('open')"></div>
      <div class="modal-panel">
        <div class="drawer-header" style="padding:0 0 16px">
          <h2>Cambiar estado</h2>
          <button type="button" class="drawer-close" aria-label="Cerrar" onclick="document.getElementById('modal-cambiar-estado').classList.remove('open')"><%- include('../partials/icon', { kind: 'x', size: 18 }) %></button>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px">
          <% if (task.status === 'pendiente') { %>
          <form method="post" action="/tareas/<%= task.id %>/estado"><input type="hidden" name="status" value="activa" /><button class="btn primary" type="submit" style="width:100%">Iniciar</button></form>
          <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="bloqueada" /><input name="note" placeholder="Motivo" required style="flex:1;padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn" type="submit">Bloquear</button></form>
          <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="cancelada" /><input name="note" placeholder="Motivo" required style="flex:1;padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn danger" type="submit">Cancelar</button></form>
          <% } %>
          <% if (task.status === 'activa') { %>
          <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="bloqueada" /><input name="note" placeholder="Motivo" required style="flex:1;padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn" type="submit">Bloquear</button></form>
          <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="cancelada" /><input name="note" placeholder="Motivo" required style="flex:1;padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn danger" type="submit">Cancelar</button></form>
          <% } %>
          <% if (task.status === 'revision') { %>
            <% if (isLeaderOrAdmin) { %>
            <form method="post" action="/tareas/<%= task.id %>/estado" onsubmit="return aiacademyConfirmSubmit(this, '¿Aprobar esta tarea? Pasa a completada y no se puede deshacer.')" style="display:flex;gap:6px">
              <input type="hidden" name="status" value="completada" />
              <% if (!task.evidence) { %><input name="evidence" placeholder="Evidencia" required style="flex:1;padding:8px;border:1px solid var(--line);border-radius:8px" /><% } %>
              <button class="btn primary" type="submit">Aprobar</button>
            </form>
            <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="activa" /><input name="note" placeholder="Observaciones" required style="flex:1;padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn" type="submit">Devolver a activa</button></form>
            <% } %>
          <% } %>
          <% if (task.status === 'bloqueada') { %>
          <form method="post" action="/tareas/<%= task.id %>/estado"><input type="hidden" name="status" value="pendiente" /><button class="btn" type="submit" style="width:100%">Desbloquear</button></form>
          <form method="post" action="/tareas/<%= task.id %>/estado" style="display:flex;gap:6px"><input type="hidden" name="status" value="cancelada" /><input name="note" placeholder="Motivo" required style="flex:1;padding:8px;border:1px solid var(--line);border-radius:8px" /><button class="btn danger" type="submit">Cancelar</button></form>
          <% } %>
        </div>
      </div>
    </div>

    <% if (canRequestSupport) { %>
    <div class="modal" id="modal-solicitar-apoyo">
      <div class="modal-backdrop" onclick="document.getElementById('modal-solicitar-apoyo').classList.remove('open')"></div>
      <div class="modal-panel">
        <div class="drawer-header" style="padding:0 0 16px">
          <h2>Solicitud de apoyo</h2>
          <button type="button" class="drawer-close" aria-label="Cerrar" onclick="document.getElementById('modal-solicitar-apoyo').classList.remove('open')"><%- include('../partials/icon', { kind: 'x', size: 18 }) %></button>
        </div>
        <form method="post" action="/tareas/<%= task.id %>/apoyo" class="form-grid">
          <div class="field full"><label>Persona *</label>
            <select name="targetUserId" required>
              <% users.filter(function(u){return u.id !== task.ownerId}).forEach(function(u) { %><option value="<%= u.id %>"><%= u.name %></option><% }) %>
            </select>
          </div>
          <div class="field full"><label>Modalidad *</label>
            <select name="mode" required>
              <option value="invite">Invitar (la persona acepta)</option>
              <option value="apply">Pedir que el líder la asigne</option>
            </select>
          </div>
          <div class="field full"><label>Motivo</label><input name="reason" maxlength="1000" /></div>
          <div class="foot-actions full"><button type="submit" class="btn primary">Pedir apoyo</button></div>
        </form>
      </div>
    </div>
    <% } %>

    <% if (user.id === task.ownerId) { %>
    <div class="modal" id="modal-registrar-horas">
      <div class="modal-backdrop" onclick="document.getElementById('modal-registrar-horas').classList.remove('open')"></div>
      <div class="modal-panel">
        <div class="drawer-header" style="padding:0 0 16px">
          <h2>Registrar horas</h2>
          <button type="button" class="drawer-close" aria-label="Cerrar" onclick="document.getElementById('modal-registrar-horas').classList.remove('open')"><%- include('../partials/icon', { kind: 'x', size: 18 }) %></button>
        </div>
        <form method="post" action="/tareas/<%= task.id %>/horas" class="form-grid" id="form-registrar-horas">
          <div class="field full"><label>Fecha *</label><input type="date" name="date" required /></div>
          <div class="field"><label>Inicio *</label><input type="time" id="horas-inicio" required /></div>
          <div class="field"><label>Fin *</label><input type="time" id="horas-fin" required /></div>
          <input type="hidden" name="hours" id="horas-calculadas" />
          <p class="subtitle full" id="horas-resultado">Horas: —</p>
          <div class="field full"><label>Descripción</label><textarea name="description" maxlength="1000" placeholder="¿Qué hiciste en este bloque de horas?"></textarea></div>
          <div class="foot-actions full"><button type="submit" class="btn primary" id="btn-registrar-horas" disabled>Registrar</button></div>
        </form>
      </div>
    </div>
    <script>
    (function () {
      var inicio = document.getElementById('horas-inicio');
      var fin = document.getElementById('horas-fin');
      var hidden = document.getElementById('horas-calculadas');
      var resultado = document.getElementById('horas-resultado');
      var btn = document.getElementById('btn-registrar-horas');
      if (!inicio || !fin) return;
      function recalc() {
        if (!inicio.value || !fin.value) {
          hidden.value = '';
          resultado.textContent = 'Horas: —';
          btn.disabled = true;
          return;
        }
        var start = inicio.value.split(':').map(Number);
        var end = fin.value.split(':').map(Number);
        var minutes = (end[0] * 60 + end[1]) - (start[0] * 60 + start[1]);
        if (minutes <= 0) {
          hidden.value = '';
          resultado.textContent = 'El fin debe ser posterior al inicio.';
          btn.disabled = true;
          return;
        }
        var hours = Math.round((minutes / 60) * 2) / 2;
        hidden.value = String(hours);
        resultado.textContent = 'Horas: ' + hours + ' h';
        btn.disabled = false;
      }
      inicio.addEventListener('input', recalc);
      fin.addEventListener('input', recalc);
    })();
    </script>
    <% } %>
  </main>
</div>
</body>
</html>
