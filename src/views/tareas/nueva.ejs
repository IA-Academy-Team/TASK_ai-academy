<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Crear tarea</title>
<%- include('../partials/theme-init') %>
<%- include('../partials/styles') %>
</head>
<body>
<div class="app">
  <%- include('../partials/sidebar', { active: 'crear-tarea', user }) %>
  <main class="content">
    <%- include('../partials/navbar', { active: 'crear-tarea' }) %>
    <div class="topbar">
      <div>
        <p class="subtitle"><a href="/proyectos">&larr; Proyectos</a></p>
        <h1 class="page-title">Crear tarea</h1>
      </div>
    </div>

    <% if (error) { %><div class="error">Revisa los campos obligatorios de la tarea.</div><% } %>

    <% if (!project && !independent && !pickingProject) { %>
    <section class="card pad">
      <p class="subtitle" style="margin-top:0">¿La tarea es independiente o pertenece a un proyecto?</p>
      <div class="foot-actions">
        <a href="/tareas/nueva?project=independent" class="btn subtle" style="flex:1;justify-content:center">Tarea independiente</a>
        <a href="/tareas/nueva?tipo=proyecto" class="btn primary" style="flex:1;justify-content:center">Pertenece a un proyecto</a>
      </div>
    </section>
    <% } else if (!project && !independent) { %>
    <section class="card pad">
      <p class="subtitle" style="margin-top:0">Elige el proyecto.</p>
      <form method="get" action="/tareas/nueva" class="form-grid">
        <input type="hidden" name="tipo" value="proyecto" />
        <div class="field full"><label>Proyecto</label>
          <select name="project">
            <option value="">Elige un proyecto</option>
            <% projects.forEach(function(p) { %><option value="<%= p.id %>"><%= p.code %> — <%= p.name %></option><% }) %>
          </select>
        </div>
        <div class="foot-actions full">
          <a href="/tareas/nueva" class="btn subtle">&larr; Atrás</a>
          <button type="submit" class="btn primary">Continuar</button>
        </div>
      </form>
    </section>
    <% } else { %>
    <p class="subtitle"><% if (independent) { %>Tarea independiente (sin proyecto)<% } else { %><%= project.code %> — <%= project.name %><% } %></p>

    <div class="task-create-steps">
      <div class="task-create-step"><b>1</b> Proyecto</div>
      <div class="task-create-step"><b>2</b> Detalles</div>
      <div class="task-create-step"><b>3</b> Asignación y prioridad</div>
      <div class="task-create-step"><b>4</b> Revisar y crear</div>
    </div>

    <div class="task-create-layout">
    <section class="card pad">
      <form method="post" action="/tareas" class="form-grid" id="task-create-form">
        <% if (!independent) { %><input type="hidden" name="projectId" value="<%= project.id %>" /><% } %>
        <div class="field full"><label>Título *</label><input id="f-title" name="title" maxlength="200" required /></div>
        <div class="field full"><label>Entregable esperado *</label><input name="deliverable" maxlength="300" required /></div>
        <div class="field full"><label>Descripción</label><textarea name="description" maxlength="2000"></textarea></div>
        <% var showOwnerSelect = !independent || user.role === 'administrador'; %>
        <% if (!showOwnerSelect) { %>
        <input type="hidden" name="ownerId" value="<%= user.id %>" />
        <div class="field"><label>Responsable</label><input value="<%= user.name || user.email %> (vos)" disabled /></div>
        <% } else { %>
        <div class="field"><label>Responsable *</label>
          <select name="ownerId" required>
            <% allUsers.forEach(function(u) { %><option value="<%= u.id %>" <%= independent && u.id === user.id ? 'selected' : '' %>><%= u.name %></option><% }) %>
          </select>
        </div>
        <% } %>
        <div class="field full"><label>Apoyo</label>
          <div class="dropdown-select" id="support-dropdown">
            <button type="button" class="dropdown-select-trigger" onclick="document.getElementById('support-dropdown').classList.toggle('open')">
              <span id="support-label">Selecciona apoyo</span>
              <%- include('../partials/icon', { kind: 'chevron-down', size: 14 }) %>
            </button>
            <div class="dropdown-select-panel people-grid" id="support-panel">
              <% allUsers.forEach(function(u) { %>
              <label class="person-chip">
                <input type="checkbox" name="support" value="<%= u.id %>" onchange="aiacademyUpdateSupportSelection()" />
                <span class="chip-avatar" style="background:<%= u.color || '#7346CC' %>;color:#fff"><%= (u.name || '?').charAt(0).toUpperCase() %></span>
                <%= u.name %>
              </label>
              <% }) %>
            </div>
          </div>
          <div class="selected-pills" id="support-selected"></div>
        </div>
        <div class="field"><label>Prioridad *</label>
          <select id="f-priority" name="priority" required>
            <option value="baja">Baja</option>
            <option value="media" selected>Media</option>
            <option value="alta">Alta</option>
            <option value="critica">Crítica</option>
          </select>
        </div>
        <div class="field"><label>Horas estimadas *</label><input id="f-estimate" type="number" name="estimate" min="0.5" step="0.5" required /></div>
        <div class="field"><label>Fecha límite *</label><input id="f-due" type="date" name="due" required /></div>
        <div class="field"><label>Hora de entrega</label><input id="f-due-time" type="time" name="dueTime" /></div>
        <div class="foot-actions full">
          <a href="/tareas/nueva" class="btn subtle"><% if (independent) { %>Elegir un proyecto<% } else { %>Elegir otro proyecto<% } %></a>
          <button type="submit" class="btn primary">Crear tarea</button>
        </div>
      </form>
    </section>

    <aside class="task-create-preview">
      <div class="card pad">
        <div class="sectiontitle"><h2>Vista previa</h2></div>
        <div class="task-create-preview-row"><span>Título</span><strong id="pv-title">Sin título</strong></div>
        <div class="task-create-preview-row"><span>Proyecto</span><strong><% if (independent) { %>Ninguno<% } else { %><%= project.code %><% } %></strong></div>
        <div class="task-create-preview-row"><span>Estado</span><strong>Pendiente</strong></div>
        <div class="task-create-preview-row"><span>Prioridad</span><strong id="pv-priority">Media</strong></div>
        <div class="task-create-preview-row"><span>Horas est.</span><strong id="pv-estimate">—</strong></div>
        <div class="task-create-preview-row"><span>Vence</span><strong id="pv-due">—</strong></div>
      </div>
      <div class="card pad">
        <div class="sectiontitle"><h2><% if (independent) { %>Otras tareas independientes<% } else { %>Tareas del proyecto<% } %></h2></div>
        <% if (allTasks.length === 0) { %>
        <%- include('../partials/empty-state', { text: independent ? 'Todavía no hay tareas independientes.' : 'Todavía no hay tareas en este proyecto.' }) %>
        <% } else { %>
        <div class="task-create-related">
          <% allTasks.forEach(function(t) { %>
          <a href="/tareas/<%= t.id %>"><span>#<%= t.order %> <%= t.title %></span><span class="badge <%= t.status %>"><%= t.status %></span></a>
          <% }) %>
        </div>
        <% } %>
      </div>
    </aside>
    </div>

    <script>
    (function () {
      var form = document.getElementById('task-create-form');
      if (!form) return;
      var pvTitle = document.getElementById('pv-title');
      var pvPriority = document.getElementById('pv-priority');
      var pvEstimate = document.getElementById('pv-estimate');
      var pvDue = document.getElementById('pv-due');
      var titleInput = document.getElementById('f-title');
      var priorityInput = document.getElementById('f-priority');
      var estimateInput = document.getElementById('f-estimate');
      var dueInput = document.getElementById('f-due');
      var dueTimeInput = document.getElementById('f-due-time');
      var PRIORITY_LABEL = { baja: 'Baja', media: 'Media', alta: 'Alta', critica: 'Crítica' };
      form.addEventListener('input', function () {
        pvTitle.textContent = titleInput.value.trim() || 'Sin título';
        pvPriority.textContent = PRIORITY_LABEL[priorityInput.value] || priorityInput.value;
        pvEstimate.textContent = estimateInput.value ? estimateInput.value + ' h' : '—';
        pvDue.textContent = dueInput.value ? dueInput.value + (dueTimeInput.value ? ' ' + dueTimeInput.value : '') : '—';
      });
    })();

    function aiacademyUpdateSupportSelection() {
      var boxes = Array.prototype.slice.call(document.querySelectorAll('#support-panel input[type=checkbox]'));
      var checked = boxes.filter(function (cb) { return cb.checked; });
      var label = document.getElementById('support-label');
      label.textContent = checked.length === 0
        ? 'Selecciona apoyo'
        : checked.length + ' seleccionado' + (checked.length === 1 ? '' : 's');

      var selected = document.getElementById('support-selected');
      selected.replaceChildren();
      checked.forEach(function (cb) {
        var pill = document.createElement('span');
        pill.className = 'selected-pill';
        var name = document.createElement('span');
        name.textContent = cb.closest('.person-chip').textContent.trim();
        var remove = document.createElement('button');
        remove.type = 'button';
        remove.setAttribute('aria-label', 'Quitar');
        remove.textContent = '×';
        remove.onclick = function () {
          cb.checked = false;
          aiacademyUpdateSupportSelection();
        };
        pill.appendChild(name);
        pill.appendChild(remove);
        selected.appendChild(pill);
      });
      selected.style.display = checked.length ? 'flex' : 'none';
    }
    aiacademyUpdateSupportSelection();

    document.addEventListener('click', function (e) {
      var dropdown = document.getElementById('support-dropdown');
      if (dropdown && !dropdown.contains(e.target)) dropdown.classList.remove('open');
    });
    </script>
    <% } %>
  </main>
</div>
</body>
</html>
