<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Error <%= status %></title>
<%- include('partials/theme-init') %>
<%- include('partials/styles') %>
<style>
  .error-card{max-width:420px;margin:60px auto;text-align:center}
  .error-code{font-size:13px;font-weight:700;color:var(--accent);letter-spacing:.08em;text-transform:uppercase;margin:0 0 8px}
  .error-card h1{font-size:19px;margin:0 0 10px}
  .error-card p{color:var(--muted);font-size:13px;margin:0 0 22px}
</style>
</head>
<body>
<% if (typeof user !== 'undefined' && user) { %>
<div class="app">
  <%- include('partials/sidebar', { active: '', user }) %>
  <main class="content">
    <%- include('partials/navbar', { active: '', crumbs: [{ label: 'Error' }] }) %>
    <section class="card pad error-card">
      <p class="error-code">Error <%= status %></p>
      <h1><%= status === 404 ? 'No encontrado' : status === 403 ? 'Sin permiso' : 'Algo salió mal' %></h1>
      <p><%= message %></p>
      <a class="btn primary" href="/">Volver al dashboard</a>
    </section>
  </main>
</div>
<% } else { %>
<main class="login-main" style="min-height:100vh;display:grid;place-items:center;padding:28px 16px">
  <section class="card pad error-card">
    <p class="error-code">Error <%= status %></p>
    <h1><%= status === 404 ? 'No encontrado' : status === 403 ? 'Sin permiso' : 'Algo salió mal' %></h1>
    <p><%= message %></p>
    <a class="btn primary" href="/login">Ir al login</a>
  </section>
</main>
<% } %>
</body>
</html>
