<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<title>AI Academy · Centro de control — Login</title>
<style>
  :root{--primary:#7346CC;--primary-dark:#5A37A5;--bg:#F7F8FC;--paper:#FFF;--line:#E9E8F0;--ink:#252138;--text:#5A566B;--red:#BD4565;--redlight:#FCEBF0}
  *{box-sizing:border-box}
  html,body{margin:0;min-height:100%;background:var(--bg);font-family:'Poppins','Segoe UI',Arial,sans-serif;font-size:13px;display:grid;place-items:center}
  form{background:var(--paper);border:1px solid var(--line);border-radius:13px;padding:32px;width:320px;box-shadow:0 6px 24px rgba(25,20,45,.035)}
  h1{font-size:16px;color:var(--ink);margin:0 0 20px}
  label{display:block;font-size:11px;color:var(--text);margin-bottom:4px}
  input{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin-bottom:14px;font:inherit}
  button{width:100%;padding:10px;border:0;border-radius:10px;background:var(--primary);color:#fff;font-weight:650;cursor:pointer}
  button:hover{background:var(--primary-dark)}
  #error{color:var(--red);background:var(--redlight);border-radius:8px;padding:8px;margin-bottom:12px;display:none;font-size:12px}
</style>
</head>
<body>
<form id="login-form">
  <h1>AI Academy · Centro de control</h1>
  <div id="error"></div>
  <label for="email">Email</label>
  <input id="email" name="email" type="email" required />
  <label for="password">Contraseña</label>
  <input id="password" name="password" type="password" required />
  <button type="submit">Entrar</button>
</form>
<script>
  document.getElementById("login-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = document.getElementById("email").value;
    const password = document.getElementById("password").value;
    const errorBox = document.getElementById("error");
    errorBox.style.display = "none";
    const res = await fetch("/api/auth/sign-in/email", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email, password }),
    });
    if (res.ok) {
      window.location.href = "/";
    } else {
      errorBox.textContent = "Email o contraseña incorrectos.";
      errorBox.style.display = "block";
    }
  });
</script>
</body>
</html>
