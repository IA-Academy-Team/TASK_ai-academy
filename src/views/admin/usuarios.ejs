<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Usuarios</title>
<%- include('../partials/theme-init') %>
<%- include('../partials/styles') %>
</head>
<body>
<div class="app">
  <%- include('../partials/sidebar', { active: 'usuarios', user }) %>
  <main class="content">
    <%- include('../partials/navbar', { active: 'usuarios', actions: [{ label: 'Crear usuario', icon: 'plus', onclick: "document.getElementById('create-user-modal').classList.add('open')" }] }) %>
    <div class="topbar">
      <div>
        <h1 class="page-title">Administración de usuarios</h1>
        <p class="subtitle">Crear cuentas, asignar su rol y gestionar el acceso del equipo.</p>
      </div>
    </div>

    <section class="card pad">
      <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Nombre</th><th>Email</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>
          <% users.forEach(function(u) { %>
          <tr>
            <td><%= u.name %></td>
            <td><%= u.email %></td>
            <td>
              <% if (u.id === user.id) { %>
              <span class="badge <%= u.role %>"><%= roleLabels[u.role] || u.role %></span>
              <% } else { %>
              <form method="post" action="/admin/usuarios/<%= u.id %>/rol" style="display:flex;gap:6px;align-items:center" onsubmit="return confirm('¿Cambiar el rol de <%= u.name %> a ' + this.role.options[this.role.selectedIndex].text + '?')">
                <select name="role" aria-label="Rol de <%= u.name %>">
                  <% roles.forEach(function(r) { %><option value="<%= r %>" <%= r === u.role ? 'selected' : '' %>><%= roleLabels[r] %></option><% }) %>
                </select>
                <button type="submit" class="btn subtle">Guardar</button>
              </form>
              <% } %>
            </td>
            <td><span class="badge <%= u.isActive ? '' : 'off' %>"><%= u.isActive ? 'activo' : 'inactivo' %></span></td>
            <td>
              <% if (u.isActive || u.id !== user.id) { %>
              <div style="display:flex;flex-wrap:wrap;gap:6px">
                  <% if (u.isActive) { %>
                  <form method="post" action="/admin/usuarios/<%= u.id %>/desactivar"><button type="submit" class="btn subtle">Desactivar</button></form>
                  <% } %>
                  <% if (u.id !== user.id) { %>
                  <form method="post" action="/admin/usuarios/<%= u.id %>/restablecer-password" onsubmit="return confirm('¿Restablecer la contraseña de <%= u.name %> a la genérica? Va a tener que cambiarla al volver a iniciar sesión.')"><button type="submit" class="btn subtle">Restablecer contraseña</button></form>
                  <button type="button" class="btn danger" data-user-id="<%= u.id %>" data-user-name="<%= u.name %>" onclick="openDeleteModal(this)">Eliminar</button>
                  <% } %>
              </div>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </section>

    <div class="modal<%= error ? ' open' : '' %>" id="create-user-modal">
      <div class="modal-backdrop" onclick="document.getElementById('create-user-modal').classList.remove('open')"></div>
      <div class="modal-panel">
        <h3>Crear usuario</h3>
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <p style="color:var(--muted);font-size:12px;margin:0 0 14px">
          Se crea con la contraseña genérica <strong><%= genericPassword %></strong>. El usuario
          deberá cambiarla al iniciar sesión por primera vez.
        </p>
        <form method="post" action="/admin/usuarios" class="form-grid">
          <div class="field full"><label>Nombre *</label><input name="name" placeholder="Nombre" required /></div>
          <div class="field full"><label>Email *</label><input name="email" type="email" placeholder="email@aiacademy.local" required /></div>
          <div class="field full"><label>Rol *</label>
            <select name="role" required>
              <% roles.forEach(function(r) { %><option value="<%= r %>"><%= roleLabels[r] %></option><% }) %>
            </select>
          </div>
          <div class="foot-actions full">
            <button type="button" class="btn" onclick="document.getElementById('create-user-modal').classList.remove('open')">Cancelar</button>
            <button type="submit" class="btn primary">Crear usuario</button>
          </div>
        </form>
      </div>
    </div>

    <div class="modal" id="confirm-delete-modal">
      <div class="modal-backdrop" onclick="closeDeleteModal()"></div>
      <div class="modal-panel">
        <h3>Eliminar usuario</h3>
        <p id="confirm-delete-text"></p>
        <form method="post" id="confirm-delete-form">
          <div class="foot-actions">
            <button type="button" class="btn" onclick="closeDeleteModal()">Cancelar</button>
            <button type="submit" class="btn danger">Eliminar definitivamente</button>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>
<script>
function openDeleteModal(btn) {
  var name = btn.getAttribute('data-user-name');
  var id = btn.getAttribute('data-user-id');
  document.getElementById('confirm-delete-text').textContent =
    'Esta acción no se puede deshacer. ¿Eliminar a ' + name + ' permanentemente?';
  document.getElementById('confirm-delete-form').setAttribute('action', '/admin/usuarios/' + id + '/eliminar');
  document.getElementById('confirm-delete-modal').classList.add('open');
  document.querySelectorAll('.row-menu.open').forEach(function (m) { m.classList.remove('open'); });
}
function closeDeleteModal() {
  document.getElementById('confirm-delete-modal').classList.remove('open');
}
</script>
</body>
</html>
