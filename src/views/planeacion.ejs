<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Plan semanal</title>
<%- include('partials/theme-init') %>
<%- include('partials/styles') %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'plan-semanal', user }) %>
  <main class="content">
    <%- include('partials/navbar', { active: 'plan-semanal', actions: [{ label: '+ Crear tarea', href: '/tareas/nueva' }] }) %>
    <div class="topbar">
      <div>
        <h1 class="page-title">Plan semanal</h1>
        <p class="subtitle">Lunes a viernes, por fecha límite.</p>
      </div>
    </div>

    <form method="get" action="/planeacion" class="plan-toolbar">
      <select name="proyecto" class="plan-project-select" onchange="this.form.submit()">
        <option value="">Todos los proyectos</option>
        <% projects.forEach(function(p) { %><option value="<%= p.id %>" <%= projectFilter === p.id ? 'selected' : '' %>><%= p.code %> — <%= p.name %></option><% }) %>
      </select>
      <input type="hidden" name="semana" value="<%= weekOffset %>" />

      <div class="week-nav">
        <span class="week-nav-label">Semana</span>
        <div class="week-nav-controls">
          <a href="/planeacion?semana=<%= weekOffset - 1 %>&proyecto=<%= projectFilter || '' %>" class="week-nav-btn week-nav-btn-prev" aria-label="Semana anterior"><%- include('partials/icon', { kind: 'chevron-right', size: 15 }) %></a>
          <a href="/planeacion?semana=<%= weekOffset + 1 %>&proyecto=<%= projectFilter || '' %>" class="week-nav-btn" aria-label="Semana siguiente"><%- include('partials/icon', { kind: 'chevron-right', size: 15 }) %></a>
        </div>
      </div>
    </form>

    <div>
      <div class="week-calendar-grid">
        <div class="week-calendar-timeaxis-spacer">
          <div class="week-calendar-daylabel" style="visibility:hidden">·</div>
          <div class="week-calendar-timeaxis" style="height:<%= gridHeight %>px">
            <% marks.forEach(function(m) { %>
            <span class="week-calendar-tick week-calendar-tick-<%= m.anchor %>" style="top:<%= m.top %>px"><%= m.label %></span>
            <% }) %>
          </div>
        </div>
        <% byDay.forEach(function(d) { %>
        <div class="week-calendar-column">
          <div class="week-calendar-daylabel <%= d.day === today ? 'is-today' : '' %>"><%= d.label %></div>
          <div class="week-calendar-day <%= d.day === today ? 'is-today' : '' %>" style="height:<%= gridHeight %>px">
            <% marks.forEach(function(m) { %><span class="week-calendar-gridline" style="top:<%= m.top %>px"></span><% }) %>
            <% if (d.blocks.length === 0) { %>
            <p class="week-calendar-empty">Sin tareas</p>
            <% } else { %>
            <% d.blocks.forEach(function(b) { %>
            <a href="/tareas/<%= b.id %>" class="week-calendar-block prio-<%= b.priority %>" style="top:<%= b.topPx %>px;height:<%= b.heightPx %>px" tabindex="0">
              <span class="week-calendar-block-title"><%= b.title %></span>
              <span class="week-calendar-block-owner"><%= b.ownerName %></span>
              <span class="week-calendar-block-hours"><%= b.estimate %> h</span>
            </a>
            <% }) %>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <p class="subtitle" style="margin-top:10px">Cada cuadro es una tarea independiente, ubicada según su prioridad dentro de la jornada (8-12 y 14-18) — no se solapan aunque varias personas tengan tareas el mismo día. Pasá el mouse para ver el detalle completo. No es un horario real asignado, el sistema no registra hora de inicio.</p>
    </div>
  </main>
</div>
</body>
</html>
