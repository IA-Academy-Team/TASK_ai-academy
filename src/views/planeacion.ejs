<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Plan semanal</title>
<%- include('partials/theme-init') %>
<%- include('partials/styles') %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'plan-semanal', user }) %>
  <main class="content">
    <%- include('partials/navbar', { active: 'plan-semanal', actions: [{ label: '+ Crear tarea', href: '/tareas/nueva' }] }) %>
    <div class="topbar">
      <div>
        <h1 class="page-title">Plan semanal</h1>
        <p class="subtitle">Lunes a viernes, por fecha límite.</p>
      </div>
    </div>

    <form method="get" action="/planeacion" class="filters" style="gap:12px">
      <select name="proyecto" onchange="this.form.submit()">
        <option value="">Todos los proyectos</option>
        <% projects.forEach(function(p) { %><option value="<%= p.id %>" <%= projectFilter === p.id ? 'selected' : '' %>><%= p.code %> — <%= p.name %></option><% }) %>
      </select>
      <input type="hidden" name="semana" value="<%= weekOffset %>" />
      <a href="/planeacion?semana=<%= weekOffset - 1 %>&proyecto=<%= projectFilter || '' %>" class="btn subtle">&larr; Semana anterior</a>
      <a href="/planeacion?semana=<%= weekOffset + 1 %>&proyecto=<%= projectFilter || '' %>" class="btn subtle">Semana siguiente &rarr;</a>
    </form>

    <div>
      <div class="week-calendar">
        <% byDay.forEach(function(d) { %>
        <div class="week-calendar-column">
          <div class="week-calendar-daylabel <%= d.day === today ? 'is-today' : '' %>"><%= d.label %></div>
          <div class="week-calendar-day <%= d.day === today ? 'is-today' : '' %>">
            <% if (d.blocks.length === 0) { %>
            <p class="week-calendar-empty">Sin tareas</p>
            <% } else { %>
            <% d.blocks.forEach(function(b) { %>
            <a href="/tareas/<%= b.id %>" class="week-calendar-block prio-<%= b.priority %>" tabindex="0">
              <span class="week-calendar-block-title"><%= b.title %></span>
              <span class="week-calendar-block-owner"><%= b.ownerName %></span>
              <span class="week-calendar-block-hours"><%= b.estimate %> h</span>
            </a>
            <% }) %>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <p class="subtitle" style="margin-top:10px">Cada cuadro es una tarea independiente, agrupadas por prioridad — no se solapan aunque varias personas tengan tareas el mismo día. Pasá el mouse para ver el detalle completo. No es un horario real asignado, el sistema no registra hora de inicio.</p>
    </div>

    <section class="card pad">
      <div class="sectiontitle"><h2>Capacidad de referencia</h2></div>
      <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Persona</th><th>Capacidad semanal</th></tr></thead>
        <tbody>
          <% capacity.forEach(function(u) { %>
          <tr><td><%= u.name %></td><td><%= u.weeklyCapacityHours %> h</td></tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </section>
  </main>
</div>
</body>
</html>
