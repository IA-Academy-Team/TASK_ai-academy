<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Plan semanal</title>
<%- include('partials/theme-init') %>
<%- include('partials/styles') %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'plan-semanal', user }) %>
  <main class="content">
    <%- include('partials/navbar', { active: 'plan-semanal', actions: [{ label: 'Crear tarea', href: '/tareas/nueva', icon: 'plus' }] }) %>
    <div class="topbar">
      <div>
        <h1 class="page-title">Plan semanal</h1>
        <p class="subtitle">Tareas que vencen de lunes a viernes. Arrastrá una tarjeta entre columnas para cambiar su estado.</p>
      </div>
    </div>

    <form method="get" action="/planeacion" class="plan-toolbar">
      <select name="proyecto" class="plan-project-select" onchange="this.form.submit()">
        <option value="">Todos los proyectos</option>
        <% projects.forEach(function(p) { %><option value="<%= p.id %>" <%= projectFilter === p.id ? 'selected' : '' %>><%= p.code %> — <%= p.name %></option><% }) %>
      </select>
      <input type="hidden" name="semana" value="<%= weekOffset %>" />

      <div class="week-nav">
        <span class="week-nav-label">Semana del <%= weekLabel %></span>
        <div class="week-nav-controls">
          <a href="/planeacion?semana=<%= weekOffset - 1 %>&proyecto=<%= projectFilter || '' %>" class="week-nav-btn" aria-label="Semana anterior"><%- include('partials/icon', { kind: 'chevron-left', size: 15 }) %></a>
          <a href="/planeacion?semana=<%= weekOffset + 1 %>&proyecto=<%= projectFilter || '' %>" class="week-nav-btn" aria-label="Semana siguiente"><%- include('partials/icon', { kind: 'chevron-right', size: 15 }) %></a>
        </div>
      </div>
    </form>

    <div class="kanban-board">
      <% columns.forEach(function(col) { %>
      <div class="kanban-column" data-status="<%= col.status %>">
        <div class="kanban-column-header">
          <span><%= col.label %></span>
          <span class="kanban-column-count"><%= col.tasks.length %></span>
        </div>
        <div class="kanban-column-body" data-dropzone>
          <% if (col.tasks.length === 0) { %>
          <p class="kanban-empty">Sin tareas</p>
          <% } %>
          <% col.tasks.forEach(function(t) { %>
          <div class="kanban-card prio-<%= t.priority %>" draggable="true" data-task-id="<%= t.id %>" data-status="<%= col.status %>" data-has-evidence="<%= t.hasEvidence ? '1' : '0' %>" onclick="location.href='/tareas/<%= t.id %>'">
            <span class="kanban-card-title"><%= t.title %></span>
            <span class="kanban-card-meta"><span class="color-dot" style="background:<%= t.ownerColor %>"></span><%= t.ownerName %> · <%= t.estimate %> h</span>
            <span class="kanban-card-due">Vence <%= t.due %></span>
          </div>
          <% }) %>
        </div>
      </div>
      <% }) %>
    </div>

    <div class="modal" id="modal-kanban-field">
      <div class="modal-backdrop" onclick="aiacademyCancelKanbanField()"></div>
      <div class="modal-panel">
        <div class="drawer-header" style="padding:0 0 16px">
          <h2 id="kanban-field-title">Motivo</h2>
          <button type="button" class="drawer-close" aria-label="Cerrar" onclick="aiacademyCancelKanbanField()"><%- include('partials/icon', { kind: 'x', size: 18 }) %></button>
        </div>
        <form id="form-kanban-field" onsubmit="return aiacademySubmitKanbanField(event)">
          <div class="field full">
            <label id="kanban-field-label" for="kanban-field-input">Motivo *</label>
            <textarea id="kanban-field-input" maxlength="2000" required></textarea>
          </div>
          <div class="foot-actions full">
            <button type="button" class="btn" onclick="aiacademyCancelKanbanField()">Cancelar</button>
            <button type="submit" class="btn primary">Guardar</button>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>
<script>
var aiacademyKanbanFieldCallback = null;

function aiacademyOpenKanbanField(kind) {
  return new Promise(function (resolve) {
    aiacademyKanbanFieldCallback = resolve;
    var isEvidencia = kind === 'evidencia';
    document.getElementById('kanban-field-title').textContent = isEvidencia ? 'Evidencia del avance' : 'Motivo del bloqueo';
    document.getElementById('kanban-field-label').textContent = (isEvidencia ? 'Evidencia' : 'Motivo') + ' *';
    var input = document.getElementById('kanban-field-input');
    input.value = '';
    document.getElementById('modal-kanban-field').classList.add('open');
    setTimeout(function () { input.focus(); }, 50);
  });
}

function aiacademyCancelKanbanField() {
  document.getElementById('modal-kanban-field').classList.remove('open');
  if (aiacademyKanbanFieldCallback) {
    var resolve = aiacademyKanbanFieldCallback;
    aiacademyKanbanFieldCallback = null;
    resolve(null);
  }
}

function aiacademySubmitKanbanField(e) {
  e.preventDefault();
  var value = document.getElementById('kanban-field-input').value.trim();
  if (!value) return false;
  document.getElementById('modal-kanban-field').classList.remove('open');
  if (aiacademyKanbanFieldCallback) {
    var resolve = aiacademyKanbanFieldCallback;
    aiacademyKanbanFieldCallback = null;
    resolve(value);
  }
  return false;
}

(function () {
  var dragged = null;

  function needsNote(fromStatus, toStatus) {
    return toStatus === 'bloqueada' || (fromStatus === 'revision' && toStatus === 'activa');
  }

  function needsEvidence(toStatus, hasEvidence) {
    return toStatus === 'revision' && !hasEvidence;
  }

  function updateCounts() {
    document.querySelectorAll('.kanban-column').forEach(function (col) {
      var count = col.querySelectorAll('.kanban-card').length;
      var countEl = col.querySelector('.kanban-column-count');
      if (countEl) countEl.textContent = String(count);
      var body = col.querySelector('.kanban-column-body');
      var empty = body.querySelector('.kanban-empty');
      if (count === 0 && !empty) {
        var p = document.createElement('p');
        p.className = 'kanban-empty';
        p.textContent = 'Sin tareas';
        body.appendChild(p);
      } else if (count > 0 && empty) {
        empty.remove();
      }
    });
  }

  function moveCard(card, zone, fromStatus, toStatus, taskId, extra) {
    var originalParent = card.parentElement;
    var originalNext = card.nextSibling;
    var originalHasEvidence = card.getAttribute('data-has-evidence');
    var emptyPlaceholder = zone.querySelector('.kanban-empty');
    if (emptyPlaceholder) emptyPlaceholder.remove();
    zone.appendChild(card);
    card.setAttribute('data-status', toStatus);
    if (extra.evidence) card.setAttribute('data-has-evidence', '1');
    updateCounts();

    function revert() {
      if (originalNext) {
        originalParent.insertBefore(card, originalNext);
      } else {
        originalParent.appendChild(card);
      }
      card.setAttribute('data-status', fromStatus);
      card.setAttribute('data-has-evidence', originalHasEvidence);
      updateCounts();
    }

    var body = { status: toStatus };
    if (extra.note) body.note = extra.note;
    if (extra.evidence) body.evidence = extra.evidence;
    fetch('/tareas/' + taskId + '/estado', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body),
    })
      .then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (data) {
          return { ok: res.ok, data: data };
        });
      })
      .then(function (result) {
        if (!result.ok) {
          revert();
          showErrorAlert(
            'No se pudo mover la tarea',
            (result.data && result.data.error) || 'Intentá de nuevo.',
          );
        }
      })
      .catch(function () {
        revert();
        showErrorAlert('No se pudo mover la tarea', 'Revisá tu conexión e intentá de nuevo.');
      });
  }

  function handleDrop(card, zone, fromStatus, toStatus, taskId) {
    var hasEvidence = card.getAttribute('data-has-evidence') === '1';

    if (needsEvidence(toStatus, hasEvidence)) {
      aiacademyOpenKanbanField('evidencia').then(function (value) {
        if (!value) return;
        moveCard(card, zone, fromStatus, toStatus, taskId, { evidence: value });
      });
      return;
    }

    if (needsNote(fromStatus, toStatus)) {
      aiacademyOpenKanbanField('motivo').then(function (value) {
        if (!value) return;
        moveCard(card, zone, fromStatus, toStatus, taskId, { note: value });
      });
      return;
    }

    moveCard(card, zone, fromStatus, toStatus, taskId, {});
  }

  document.querySelectorAll('.kanban-card').forEach(function (card) {
    card.addEventListener('dragstart', function (e) {
      dragged = card;
      card.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', card.getAttribute('data-task-id') || '');
    });
    card.addEventListener('dragend', function () {
      card.classList.remove('dragging');
      dragged = null;
    });
  });

  document.querySelectorAll('.kanban-column-body').forEach(function (zone) {
    zone.addEventListener('dragover', function (e) {
      if (!dragged) return;
      e.preventDefault();
      zone.classList.add('drag-over');
    });
    zone.addEventListener('dragleave', function () {
      zone.classList.remove('drag-over');
    });
    zone.addEventListener('drop', function (e) {
      e.preventDefault();
      zone.classList.remove('drag-over');
      if (!dragged) return;
      var taskId = dragged.getAttribute('data-task-id');
      var fromStatus = dragged.getAttribute('data-status');
      var toStatus = zone.closest('.kanban-column').getAttribute('data-status');
      if (fromStatus === toStatus) return;
      handleDrop(dragged, zone, fromStatus, toStatus, taskId);
    });
  });
})();
</script>
</body>
</html>
