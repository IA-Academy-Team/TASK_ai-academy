<style>
:root{
  color-scheme:light;
  --primary:#055B5C;--primary-dark:#044748;--primary-text:#FFFFFF;--accent:#08979D;
  --nav:#0B2628;--navlight:#15393B;--lav:#E3F3F4;
  --bg:#F5F7FA;--paper:#FFFFFF;
  --ink:#172B38;--text:#526674;--muted:#61727C;--line:#D9E3E7;
  --green:#18794E;--greenlight:#E6F4EC;
  --orange:#986100;--orangelight:#FCF1E3;
  --red:#B42318;--redlight:#FBE7E5;
  --blue:#205EA6;--bluelight:#E8F0FA;
  --focus-ring:#08979D;
  --shadow:0 4px 16px rgba(23,43,56,.06);
  --duration-fast:150ms;--duration-normal:250ms;--ease-standard:cubic-bezier(.2,.8,.2,1);
}
[data-theme="dark"]{
  color-scheme:dark;
  --primary:#6EC6CA;--primary-dark:#8BD7D9;--primary-text:#10272A;--accent:#6EC6CA;
  --nav:#0E1E27;--navlight:#1C323D;--lav:rgba(110,198,202,.14);
  --bg:#111C25;--paper:#1A2B35;
  --ink:#F1F6F7;--text:#C4D5DB;--muted:#9FB4BC;--line:#38505A;
  --green:#3DDC9A;--greenlight:rgba(24,121,78,.25);
  --orange:#F2A93B;--orangelight:rgba(152,97,0,.28);
  --red:#F2777A;--redlight:rgba(180,35,24,.28);
  --blue:#6FA8E0;--bluelight:rgba(32,94,166,.28);
  --focus-ring:#6EC6CA;
  --shadow:0 4px 16px rgba(0,0,0,.35);
}
*{box-sizing:border-box}
html,body{padding:0;margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:'Poppins','Segoe UI',Arial,sans-serif;font-size:13px}
button,input,select,textarea{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--focus-ring);outline-offset:2px}
@media (prefers-reduced-motion: reduce){*,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}}
.app{min-height:100vh;display:flex}
.sidebar{width:245px;flex:0 0 245px;background:var(--nav);color:#DED8E2;display:flex;flex-direction:column;padding:24px 16px 18px;position:sticky;top:0;height:100vh}
.brand{padding:2px 11px 22px;display:flex;gap:11px;align-items:center;border-bottom:1px solid rgba(255,255,255,.12)}
.brandmark{width:42px;height:42px;border-radius:16px;background:linear-gradient(140deg,var(--accent),var(--primary));display:grid;place-items:center;font-size:17px;font-weight:850;color:var(--primary-text)}
.brand h2{margin:0;color:white;font-size:16px}
.navbtn{display:block;background:transparent;color:#C6D6D7;border:0;border-radius:12px;width:100%;padding:11.5px 13px;text-align:left;margin:2px 0;font-size:12px;font-weight:660;transition:background var(--duration-fast) var(--ease-standard),color var(--duration-fast) var(--ease-standard)}
.navbtn:hover{background:var(--navlight);color:white}.navbtn.on{background:var(--primary);color:var(--primary-text)}
.sidebar-bottom{margin-top:auto;padding-top:14px}
.content{flex:1;min-width:0;max-width:1720px;margin:0 auto;padding:25px 34px 42px}
.topbar{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:21px;flex-wrap:wrap}
.page-title{margin:0 0 7px;font-size:25px;font-weight:800;letter-spacing:-.03em}
.subtitle{margin:0;color:var(--muted);font-size:11.5px;line-height:1.55;max-width:860px}
.btn{border:1px solid var(--line);background:var(--paper);color:var(--text);font-weight:720;padding:10px 14px;border-radius:12px;display:inline-flex;gap:8px;align-items:center;font-size:11px;transition:background var(--duration-fast) var(--ease-standard)}
.btn:hover{background:var(--lav)}.btn.primary{background:var(--primary);border-color:var(--primary);color:var(--primary-text)}.btn.primary:hover{background:var(--primary-dark);border-color:var(--primary-dark)}
.btn.subtle{background:var(--lav);border-color:var(--line);color:var(--primary)}.btn.danger{color:var(--red);border-color:var(--redlight)}
.card{background:var(--paper);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);margin-bottom:20px}
.card.pad{padding:19px}
.sectiontitle{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:15px}
.sectiontitle h3{font-size:14px;font-weight:780;margin:0}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.form-grid .full{grid-column:1/-1}
.field>label{display:block;font-size:11px;font-weight:740;margin:0 0 8px}
.field input,.field select,.field textarea{width:100%;padding:11px 13px;min-height:44px;border:1px solid var(--line);border-radius:12px;background:var(--paper);color:var(--ink)}
.field textarea{resize:vertical;min-height:70px}
.foot-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}
.table{width:100%;border-collapse:collapse}
.table th{font-size:9.5px;white-space:nowrap;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--bg);text-align:left;padding:12px 11px;border-bottom:1px solid var(--line)}
.table td{font-size:11px;color:var(--text);padding:12px 11px;border-bottom:1px solid var(--line);vertical-align:middle}
.table tbody tr:hover{background:var(--lav)}.table strong{color:var(--ink)}
.badge{display:inline-flex;align-items:center;gap:6px;border-radius:7px;font-weight:760;font-size:10px;padding:6px 8px;white-space:nowrap}
.badge:before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}
.badge.pendiente{color:var(--muted);background:var(--bg)}
.badge.activa{color:var(--primary);background:var(--lav)}
.badge.revision{color:var(--orange);background:var(--orangelight)}
.badge.completada{color:var(--green);background:var(--greenlight)}
.badge.bloqueada{color:var(--red);background:var(--redlight)}
.badge.cancelada{color:var(--muted);background:var(--bg);text-decoration:line-through}
.badge.critica{color:var(--red);background:var(--redlight)}
.badge.alta{color:var(--orange);background:var(--orangelight)}
.badge.media{color:var(--blue);background:var(--bluelight)}
.badge.baja{color:var(--green);background:var(--greenlight)}
.badge.admin{background:var(--lav);color:var(--primary)}
.badge.usuario{background:var(--bluelight);color:var(--blue)}
.badge.off{background:var(--redlight);color:var(--red)}
.project-card{padding:20px;display:flex;flex-direction:column;min-height:200px;cursor:pointer;transition:border-color var(--duration-fast) var(--ease-standard),transform var(--duration-fast) var(--ease-standard)}
.project-card:hover{border-color:var(--accent);transform:translateY(-1px)}
.project-card h3{font-size:18px;margin:4px 0 5px}
.project-card p{line-height:1.55;color:var(--muted);font-size:11px;min-height:34px;margin:0 0 16px}
.project-card .meta{display:flex;gap:12px;flex-wrap:wrap;font-size:10px;color:var(--muted);margin:0 0 14px}
.project-card .line{font-size:11px;margin-top:auto;display:flex;justify-content:space-between}
.flag{background:var(--lav);color:var(--primary);font-weight:760;border-radius:6px;padding:5px 7px;font-size:10px}
.bar{height:9px;background:var(--line);border-radius:99px;overflow:hidden;margin-bottom:8px}
.bar span{height:100%;display:block;background:linear-gradient(90deg,var(--accent),var(--primary));border-radius:99px}
.project-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:15px}
.filters{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.filters a{padding:7px 13px;border-radius:999px;border:1px solid var(--line);font-size:11px;color:var(--text)}
.filters a.on{background:var(--primary);border-color:var(--primary);color:var(--primary-text)}
.empty{padding:36px 20px;text-align:center;color:var(--muted);font-size:11px}
.error{color:var(--red);background:var(--redlight);border-radius:8px;padding:10px;margin-bottom:12px;font-size:12px}
.info{background:var(--lav);border:1px solid var(--line);border-radius:12px;color:var(--primary);padding:13px;font-size:11px;line-height:1.7}
.detail-row{display:flex;justify-content:space-between;gap:10px;padding:11px 0;border-top:1px solid var(--line);font-size:11px}
.detail-row span{color:var(--muted)}
.detail-row:first-child{border-top:0}
.usergrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.usercheck{border:1px solid var(--line);border-radius:12px;padding:10px;display:flex;gap:8px;align-items:center;font-size:11px}
.usercheck input{width:auto;min-height:auto}
.kpi-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:17px}
.kpi{padding:19px 19px 17px}
.kpi small{font-size:10.5px;color:var(--muted)}
.kpi strong{display:block;font-size:26px;font-weight:820;letter-spacing:-.04em;margin:13px 0 8px;font-variant-numeric:tabular-nums}
.kpi p{font-size:10px;color:var(--muted);margin:0}
.feed{display:flex;gap:12px;border-bottom:1px solid var(--line);padding:13px 0}
.feed:last-child{border-bottom:0}
.feed .dot{width:31px;height:31px;border-radius:10px;background:var(--lav);color:var(--primary);display:grid;place-items:center;flex:0 0 auto;font-size:13px;font-weight:800}
.feed strong{font-size:11px;display:block;margin-bottom:5px}
.feed p{font-size:10px;color:var(--muted);margin:0;line-height:1.55}
.auth-shell{min-height:100vh;display:grid;place-items:center;padding:20px}
.auth-card{width:100%;max-width:360px}
.auth-card h1{font-size:16px;margin:0 0 20px}
@media (max-width:750px){.kpi-row{grid-template-columns:1fr}.sidebar{width:auto;height:auto;position:relative}}
</style>
