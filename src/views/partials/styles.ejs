<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  color-scheme:light;
  --primary:#7346CC;--primary-dark:#5A37A5;--primary-text:#FFFFFF;--accent:#7346CC;
  --nav:#1D1930;--navlight:#302844;--lav:#F0EBFB;
  --bg:#F7F8FC;--paper:#FFF;
  --ink:#252138;--text:#5A566B;--muted:#898699;--line:#E9E8F0;
  --green:#178168;--greenlight:#E7F6F0;
  --orange:#AB702B;--orangelight:#FFF1DE;
  --red:#BD4565;--redlight:#FCEBF0;
  --blue:#486FA8;--bluelight:#EAF1FC;
  --focus-ring:#C3AAF9;
  --shadow:0 6px 24px rgba(25,20,45,.035);
  --duration-fast:150ms;--duration-normal:250ms;--ease-standard:cubic-bezier(.2,.8,.2,1);
  --radius-card:18px;--radius-control:12px;
  --shadow-1:var(--shadow);--shadow-2:0 8px 24px rgba(23,43,56,.12);
  --ease:var(--ease-standard);--t-fast:var(--duration-fast);--t-base:var(--duration-normal);
  --border:color-mix(in srgb, var(--text) 8%, transparent);
}
[data-theme="dark"]{
  color-scheme:dark;
  --primary:#9636FF;--primary-dark:#AD5CFF;--primary-text:#FFFFFF;--accent:#9636FF;
  --nav:#0F0E11;--navlight:#221B2E;--lav:rgba(150,54,255,.16);
  --bg:#141316;--paper:#201E24;
  --ink:#F3F1F6;--text:#C7C3CE;--muted:#9C98A3;--line:#3A3640;
  --green:#3DDC9A;--greenlight:rgba(24,121,78,.25);
  --orange:#F2A93B;--orangelight:rgba(152,97,0,.28);
  --red:#F2777A;--redlight:rgba(180,35,24,.28);
  --blue:#6FA8E0;--bluelight:rgba(32,94,166,.28);
  --focus-ring:#9636FF;
  --shadow:0 4px 16px rgba(0,0,0,.4);
  --shadow-2:0 8px 24px rgba(0,0,0,.45);
}
@view-transition{navigation:auto}
*{box-sizing:border-box}
html,body{padding:0;margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:'Poppins','Segoe UI',Arial,sans-serif;font-size:14px}
body{transition:background-color var(--t-base) var(--ease),color var(--t-base) var(--ease)}
button,input,select,textarea{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--focus-ring);outline-offset:2px}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
main>*{animation:rise 320ms var(--ease) both}
main>*:nth-child(2){animation-delay:40ms}
main>*:nth-child(3){animation-delay:80ms}
main>*:nth-child(4){animation-delay:120ms}
@keyframes badgepop{0%{transform:scale(1)}50%{transform:scale(1.08)}100%{transform:scale(1)}}
.badge.just-updated{animation:badgepop 200ms var(--ease)}
@keyframes checkdraw{from{stroke-dashoffset:16}to{stroke-dashoffset:0}}
.badge-check{width:11px;height:11px;margin-right:3px;vertical-align:-1px;stroke-dasharray:16;stroke-dashoffset:16;animation:checkdraw 300ms var(--ease) 150ms forwards}
.progress-ring-fill{animation:ringdraw 500ms var(--ease) 100ms backwards}
@keyframes ringdraw{from{stroke-dashoffset:var(--ring-start)}to{stroke-dashoffset:var(--ring-end)}}
@media (prefers-reduced-motion: reduce){*,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}}
.app{min-height:100vh;display:flex}
.sidebar{width:245px;background:var(--nav);color:#C8BED8;display:flex;flex-direction:column;padding:24px 16px 18px;position:fixed;top:0;left:0;height:100vh;z-index:85;transition:background-color var(--t-base) var(--ease),width var(--t-base) var(--ease)}
.brand{width:100%;padding:2px 11px 22px;display:flex;gap:11px;align-items:center;border-bottom:1px solid rgba(255,255,255,.12);background:transparent;border-left:0;border-right:0;border-top:0;color:inherit;text-align:left;font:inherit}
.brandmark{width:42px;height:42px;border-radius:16px;object-fit:cover;display:block}
.brand h2{margin:0;color:white;font-size:16px;opacity:1;transition:opacity var(--duration-fast) var(--ease-standard)}
.navbtn{display:flex;align-items:center;gap:9px;background:transparent;color:#C8BED8;border:0;border-radius:var(--radius-control);width:100%;padding:9.5px 13px;text-align:left;margin:2px 0;font-size:12px;font-weight:660;transition:background var(--duration-fast) var(--ease-standard),color var(--duration-fast) var(--ease-standard)}
.navbtn .icon{flex:0 0 auto;opacity:.85}
.navbtn:hover{background:var(--navlight);color:white}.navbtn.on{background:var(--primary);color:var(--primary-text)}
.navbtn.on .icon{opacity:1}
.navcount{margin-left:auto;background:var(--accent);color:var(--nav);border-radius:999px;font-size:10px;font-weight:800;padding:2px 7px;line-height:1.4}
.navgroup{margin:4px 0 10px}
.navlabel{display:block;color:color-mix(in srgb, #C8BED8 55%, transparent);font-size:10px;font-weight:760;text-transform:uppercase;letter-spacing:.08em;padding:9px 13px 5px;opacity:1;transition:opacity var(--duration-fast) var(--ease-standard)}
.navbtn-label{opacity:1;transition:opacity var(--duration-fast) var(--ease-standard)}
.sidebar-bottom{margin-top:auto;padding-top:14px;border-top:1px solid rgba(255,255,255,.12)}
.sidebar-user{display:flex;align-items:center;gap:10px;padding:9px 13px 13px}
.sidebar-avatar{width:30px;height:30px;border-radius:999px;background:var(--primary);color:var(--primary-text);display:grid;place-items:center;flex:0 0 auto;font-size:12px;font-weight:800}
.sidebar-user-name{color:white;font-size:12px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;opacity:1;transition:opacity var(--duration-fast) var(--ease-standard)}
.content{flex:1;min-width:0;max-width:1720px;margin:0 auto;padding:25px 34px 42px;transition:margin-left var(--t-base) var(--ease)}
@media (min-width:751px){
  .content{margin-left:72px}
  .sidebar{width:72px;padding:22px 10px 16px;align-items:center}
  .brand{padding:0 0 18px;justify-content:center}
  .brand h2{opacity:0;pointer-events:none;transition-delay:0s;width:0;overflow:hidden;white-space:nowrap}
  .navgroup{width:100%}
  .navlabel{opacity:0;pointer-events:none;transition-delay:0s}
  .navbtn{justify-content:center;position:relative}
  .navbtn-label{opacity:0;pointer-events:none;transition-delay:0s;width:0;overflow:hidden;white-space:nowrap}
  .navcount{position:absolute;top:2px;right:6px;margin-left:0;padding:1px 5px;font-size:9px}
  .sidebar-user{position:relative;justify-content:center;gap:0;padding:9px 0 13px}
  .sidebar-user-name{opacity:0;pointer-events:none;transition-delay:0s;width:0}
  .navbtn[aria-label]:hover::after,.navbtn[aria-label]:focus-visible::after,.sidebar-user[aria-label]:hover::after{content:attr(aria-label);position:absolute;left:100%;top:50%;transform:translateY(-50%);margin-left:10px;background:var(--ink);color:var(--paper);padding:6px 10px;border-radius:8px;font-size:12px;font-weight:700;white-space:nowrap;box-shadow:var(--shadow-2);z-index:90;pointer-events:none}
  html[data-sidebar="expanded"] .sidebar{width:245px;padding:24px 16px 18px;align-items:stretch}
  html[data-sidebar="expanded"] .content{margin-left:245px}
  html[data-sidebar="expanded"] .brand{padding:2px 11px 22px;justify-content:flex-start}
  html[data-sidebar="expanded"] .brand h2{opacity:1;pointer-events:auto;transition-delay:120ms;width:auto;overflow:visible;white-space:nowrap}
  html[data-sidebar="expanded"] .navgroup{width:auto}
  html[data-sidebar="expanded"] .navlabel{opacity:1;pointer-events:auto;transition-delay:120ms}
  html[data-sidebar="expanded"] .navbtn{justify-content:flex-start;position:static}
  html[data-sidebar="expanded"] .navbtn-label{opacity:1;pointer-events:auto;transition-delay:120ms;width:auto;overflow:visible;white-space:nowrap}
  html[data-sidebar="expanded"] .navcount{position:static;margin-left:auto;padding:2px 7px;font-size:10px}
  html[data-sidebar="expanded"] .sidebar-user{position:static;justify-content:flex-start;gap:10px;padding:9px 13px 13px}
  html[data-sidebar="expanded"] .sidebar-user-name{opacity:1;pointer-events:auto;transition-delay:120ms;width:auto}
  html[data-sidebar="expanded"] .navbtn[aria-label]:hover::after,html[data-sidebar="expanded"] .navbtn[aria-label]:focus-visible::after,html[data-sidebar="expanded"] .sidebar-user[aria-label]:hover::after{display:none}
}
.breadcrumb{display:flex;align-items:center;flex-wrap:wrap;gap:4px;margin-bottom:14px;font-size:12px;font-weight:660}
.navbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:4px;position:sticky;top:0;z-index:30;background:var(--bg);padding-top:4px;margin-top:-4px}
.navbar .breadcrumb{margin-bottom:0}
.navbar-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.navbar-bell{position:relative;display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;flex:0 0 auto;border-radius:999px;border:1px solid var(--line);background:var(--paper);color:var(--text);transition:background var(--t-fast) var(--ease),border-color var(--t-fast) var(--ease)}
.navbar-bell:hover{background:var(--lav);border-color:var(--accent)}
.navbar-bell-count{position:absolute;top:-4px;right:-4px;background:var(--accent);color:#fff;font-size:9px;font-weight:800;border-radius:999px;min-width:16px;height:16px;display:flex;align-items:center;justify-content:center;padding:0 3px;line-height:1}
.breadcrumb a{color:var(--muted);text-decoration:none}
.breadcrumb a:hover{color:var(--accent);text-decoration:underline}
.breadcrumb-sep{display:inline-flex;align-items:center;color:var(--muted);opacity:.55}
.breadcrumb-current{color:var(--ink);font-weight:760}
.topbar{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:21px;flex-wrap:wrap}
.page-title{margin:0 0 7px;font-size:25px;font-weight:800;letter-spacing:-.03em}
.subtitle{margin:0;color:var(--muted);font-size:12px;line-height:1.55;max-width:860px}
.btn{border:1px solid var(--line);background:var(--paper);color:var(--text);font-weight:720;padding:10px 14px;border-radius:var(--radius-control);display:inline-flex;gap:8px;align-items:center;font-size:12px;transition:background var(--t-fast) var(--ease),transform var(--t-fast) var(--ease),box-shadow var(--t-fast) var(--ease)}
.btn:hover{background:var(--lav);transform:translateY(-1px);box-shadow:var(--shadow-2)}
.btn:active{transform:translateY(0) scale(.98)}
.btn.primary{background:var(--primary);border-color:var(--primary);color:var(--primary-text)}.btn.primary:hover{background:var(--primary-dark);border-color:var(--primary-dark)}
.btn.subtle{background:var(--lav);border-color:var(--line);color:var(--primary)}.btn.danger{color:var(--red);border-color:var(--redlight)}
.card{background:var(--paper);border:1px solid var(--border);border-radius:var(--radius-card);box-shadow:var(--shadow-1);margin-bottom:20px;transition:background-color var(--t-base) var(--ease),border-color var(--t-base) var(--ease)}
.card.pad{padding:19px}
.card--interactive{cursor:pointer;transition:transform var(--t-fast) var(--ease),box-shadow var(--t-fast) var(--ease)}
.card--interactive:hover{transform:translateY(-2px);box-shadow:var(--shadow-2)}
.sectiontitle{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:15px}
.sectiontitle h2{font-size:14px;font-weight:780;margin:0}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.form-grid .full{grid-column:1/-1}
.field>label{display:block;font-size:12px;font-weight:740;margin:0 0 8px}
.field input,.field select,.field textarea{width:100%;padding:11px 13px;min-height:44px;border:1px solid var(--line);border-radius:var(--radius-control);background:var(--paper);color:var(--ink);transition:border-color var(--t-fast) var(--ease),box-shadow var(--t-fast) var(--ease)}
select,.field select{appearance:none;-webkit-appearance:none;-moz-appearance:none;background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'24'%20height%3D'24'%20viewBox%3D'0%200%2024%2024'%20fill%3D'none'%20stroke%3D'%23888888'%20stroke-width%3D'2'%20stroke-linecap%3D'round'%20stroke-linejoin%3D'round'%3E%3Cpath%20d%3D'm6%209%206%206%206-6'%2F%3E%3C%2Fsvg%3E");background-repeat:no-repeat;background-position:right 12px center;background-size:16px;padding-right:36px}
.field textarea{resize:vertical;min-height:70px}
.field input:focus-visible,.field select:focus-visible,.field textarea:focus-visible{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent)}
.field-error{color:var(--red);font-size:11px;margin:6px 0 0}
.dropzone{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:24px 16px;border:1px dashed var(--line);border-radius:var(--radius-control);background:var(--paper);color:var(--muted);text-align:center;cursor:pointer;transition:border-color var(--t-fast) var(--ease),background var(--t-fast) var(--ease)}
.dropzone:hover,.dropzone.dragover{border-color:var(--primary);background:var(--lav)}
.dropzone.has-file{border-style:solid;border-color:var(--primary);color:var(--text)}
.dropzone-text{font-size:12px}
.dropzone input[type=file]{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.foot-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}
.table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
.table th{font-size:11px;white-space:nowrap;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--bg);text-align:left;padding:12px 11px;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:1}
.table td{font-size:12px;color:var(--text);padding:12px 11px;border-bottom:1px solid var(--line);vertical-align:middle}
.table tbody tr{transition:background var(--t-fast) var(--ease)}
.table tbody tr:hover{background:var(--lav)}.table strong{color:var(--ink)}
.badge{display:inline-flex;align-items:center;gap:6px;border-radius:7px;font-weight:760;font-size:11px;padding:6px 8px;white-space:nowrap}
.badge:before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}
.badge.pendiente{color:var(--muted);background:var(--bg)}
.badge.activa{color:var(--primary);background:var(--lav)}
.badge.revision{color:var(--orange);background:var(--orangelight)}
.badge.completada{color:var(--green);background:var(--greenlight)}
.badge.bloqueada{color:var(--red);background:var(--redlight)}
.badge.cancelada{color:var(--muted);background:var(--bg);text-decoration:line-through}
.badge.critica{color:var(--red);background:var(--redlight)}
.badge.alta{color:var(--orange);background:var(--orangelight)}
.badge.media{color:var(--blue);background:var(--bluelight)}
.badge.baja{color:var(--green);background:var(--greenlight)}
.badge.admin{background:var(--lav);color:var(--primary)}
.badge.usuario{background:var(--bluelight);color:var(--blue)}
.badge.off{background:var(--redlight);color:var(--red)}
.project-card{padding:20px;display:flex;flex-direction:column;min-height:200px;cursor:pointer;border-left:3px solid var(--line);transition:border-color var(--duration-fast) var(--ease-standard),transform var(--duration-fast) var(--ease-standard)}
.project-card:hover{border-color:var(--accent);transform:translateY(-1px)}
.project-card.risk-ok{border-left-color:var(--primary)}
