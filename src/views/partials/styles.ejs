.project-card .meta{display:flex;gap:12px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin:0 0 14px}
.bar-row{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;font-weight:760;color:var(--text);margin-bottom:6px}
.project-hours{background:var(--lav);border-radius:var(--radius-control);padding:12px 14px;margin-top:14px}
.project-hours small{display:block;font-size:10px;font-weight:760;letter-spacing:.06em;text-transform:uppercase;color:var(--primary)}
.project-hours strong{display:block;font-size:24px;font-weight:800;color:var(--primary);margin:4px 0 6px}
.project-hours p{margin:2px 0;font-size:11px;color:var(--text)}
.project-card-footer{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:14px;font-size:11px;color:var(--muted)}
.project-card-footer-link{color:var(--primary);font-weight:760;white-space:nowrap}
.bar-pct{font-size:11px;font-weight:760;color:var(--muted);font-variant-numeric:tabular-nums;flex:0 0 auto}
.avatar-stack{display:flex;margin-top:12px}
.avatar-chip{width:26px;height:26px;border-radius:999px;background:var(--lav);color:var(--primary);display:grid;place-items:center;font-size:10px;font-weight:800;border:2px solid var(--paper);margin-left:-8px}
.avatar-stack .avatar-chip:first-child{margin-left:0}
.avatar-more{background:var(--line);color:var(--text)}
.flag{background:var(--lav);color:var(--primary);font-weight:760;border-radius:6px;padding:5px 7px;font-size:11px}
.bar{height:9px;background:var(--line);border-radius:99px;overflow:hidden;margin-bottom:8px}
