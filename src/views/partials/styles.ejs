<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  color-scheme:light;
  --primary:#055B5C;--primary-dark:#044748;--primary-text:#FFFFFF;--accent:#08979D;
  --nav:#0B2628;--navlight:#15393B;--lav:#E3F3F4;
  --bg:#F5F7FA;--paper:#FFFFFF;
  --ink:#172B38;--text:#526674;--muted:#61727C;--line:#D9E3E7;
  --green:#18794E;--greenlight:#E6F4EC;
  --orange:#986100;--orangelight:#FCF1E3;
  --red:#B42318;--redlight:#FBE7E5;
  --blue:#205EA6;--bluelight:#E8F0FA;
  --focus-ring:#08979D;
  --shadow:0 4px 16px rgba(23,43,56,.06);
  --duration-fast:150ms;--duration-normal:250ms;--ease-standard:cubic-bezier(.2,.8,.2,1);
  --radius-card:18px;--radius-control:12px;
  --shadow-1:var(--shadow);--shadow-2:0 8px 24px rgba(23,43,56,.12);
  --ease:var(--ease-standard);--t-fast:var(--duration-fast);--t-base:var(--duration-normal);
  --border:color-mix(in srgb, var(--text) 8%, transparent);
}
[data-theme="dark"]{
  color-scheme:dark;
  --primary:#6EC6CA;--primary-dark:#8BD7D9;--primary-text:#10272A;--accent:#6EC6CA;
  --nav:#0E1E27;--navlight:#1C323D;--lav:rgba(110,198,202,.14);
  --bg:#111C25;--paper:#1A2B35;
  --ink:#F1F6F7;--text:#C4D5DB;--muted:#9FB4BC;--line:#38505A;
  --green:#3DDC9A;--greenlight:rgba(24,121,78,.25);
  --orange:#F2A93B;--orangelight:rgba(152,97,0,.28);
  --red:#F2777A;--redlight:rgba(180,35,24,.28);
  --blue:#6FA8E0;--bluelight:rgba(32,94,166,.28);
  --focus-ring:#6EC6CA;
  --shadow:0 4px 16px rgba(0,0,0,.35);
  --shadow-2:0 8px 24px rgba(0,0,0,.45);
}
@view-transition{navigation:auto}
*{box-sizing:border-box}
html,body{padding:0;margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:'Poppins','Segoe UI',Arial,sans-serif;font-size:14px}
body{transition:background-color var(--t-base) var(--ease),color var(--t-base) var(--ease)}
button,input,select,textarea{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--focus-ring);outline-offset:2px}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
main>*{animation:rise 320ms var(--ease) both}
main>*:nth-child(2){animation-delay:40ms}
main>*:nth-child(3){animation-delay:80ms}
main>*:nth-child(4){animation-delay:120ms}
@keyframes badgepop{0%{transform:scale(1)}50%{transform:scale(1.08)}100%{transform:scale(1)}}
.badge.just-updated{animation:badgepop 200ms var(--ease)}
@keyframes checkdraw{from{stroke-dashoffset:16}to{stroke-dashoffset:0}}
.badge-check{width:11px;height:11px;margin-right:3px;vertical-align:-1px;stroke-dasharray:16;stroke-dashoffset:16;animation:checkdraw 300ms var(--ease) 150ms forwards}
@media (prefers-reduced-motion: reduce){*,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}}
.app{min-height:100vh;display:flex}
.sidebar{width:245px;flex:0 0 245px;background:var(--nav);color:#DED8E2;display:flex;flex-direction:column;padding:24px 16px 18px;position:sticky;top:0;height:100vh;transition:background-color var(--t-base) var(--ease)}
.brand{padding:2px 11px 22px;display:flex;gap:11px;align-items:center;border-bottom:1px solid rgba(255,255,255,.12)}
.brandmark{width:42px;height:42px;border-radius:16px;object-fit:cover;display:block}
.brand h2{margin:0;color:white;font-size:16px}
.navbtn{display:flex;align-items:center;gap:9px;background:transparent;color:#C6D6D7;border:0;border-radius:var(--radius-control);width:100%;padding:9.5px 13px;text-align:left;margin:2px 0;font-size:12px;font-weight:660;transition:background var(--duration-fast) var(--ease-standard),color var(--duration-fast) var(--ease-standard)}
.navbtn .icon{flex:0 0 auto;opacity:.85}
.navbtn:hover{background:var(--navlight);color:white}.navbtn.on{background:var(--primary);color:var(--primary-text)}
.navbtn.on .icon{opacity:1}
.navcount{margin-left:auto;background:var(--accent);color:var(--nav);border-radius:999px;font-size:10px;font-weight:800;padding:2px 7px;line-height:1.4}
.navgroup{margin:4px 0 10px}
.navlabel{display:block;color:#7E98A0;font-size:10px;font-weight:760;text-transform:uppercase;letter-spacing:.08em;padding:9px 13px 5px}
.sidebar-bottom{margin-top:auto;padding-top:14px;border-top:1px solid rgba(255,255,255,.12)}
.sidebar-user{display:flex;align-items:center;gap:10px;padding:9px 13px 13px}
.sidebar-avatar{width:30px;height:30px;border-radius:999px;background:var(--primary);color:var(--primary-text);display:grid;place-items:center;flex:0 0 auto;font-size:12px;font-weight:800}
.sidebar-user-name{color:white;font-size:12px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.content{flex:1;min-width:0;max-width:1720px;margin:0 auto;padding:25px 34px 42px}
.topbar{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:21px;flex-wrap:wrap}
.page-title{margin:0 0 7px;font-size:25px;font-weight:800;letter-spacing:-.03em}
.subtitle{margin:0;color:var(--muted);font-size:12px;line-height:1.55;max-width:860px}
.btn{border:1px solid var(--line);background:var(--paper);color:var(--text);font-weight:720;padding:10px 14px;border-radius:var(--radius-control);display:inline-flex;gap:8px;align-items:center;font-size:12px;transition:background var(--t-fast) var(--ease),transform var(--t-fast) var(--ease),box-shadow var(--t-fast) var(--ease)}
.btn:hover{background:var(--lav);transform:translateY(-1px);box-shadow:var(--shadow-2)}
.btn:active{transform:translateY(0) scale(.98)}
.btn.primary{background:var(--primary);border-color:var(--primary);color:var(--primary-text)}.btn.primary:hover{background:var(--primary-dark);border-color:var(--primary-dark)}
.btn.subtle{background:var(--lav);border-color:var(--line);color:var(--primary)}.btn.danger{color:var(--red);border-color:var(--redlight)}
.card{background:var(--paper);border:1px solid var(--border);border-radius:var(--radius-card);box-shadow:var(--shadow-1);margin-bottom:20px;transition:background-color var(--t-base) var(--ease),border-color var(--t-base) var(--ease)}
.card.pad{padding:19px}
.card--interactive{cursor:pointer;transition:transform var(--t-fast) var(--ease),box-shadow var(--t-fast) var(--ease)}
.card--interactive:hover{transform:translateY(-2px);box-shadow:var(--shadow-2)}
.sectiontitle{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:15px}
.sectiontitle h2{font-size:14px;font-weight:780;margin:0}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.form-grid .full{grid-column:1/-1}
.field>label{display:block;font-size:12px;font-weight:740;margin:0 0 8px}
.field input,.field select,.field textarea{width:100%;padding:11px 13px;min-height:44px;border:1px solid var(--line);border-radius:var(--radius-control);background:var(--paper);color:var(--ink);transition:border-color var(--t-fast) var(--ease),box-shadow var(--t-fast) var(--ease)}
.field textarea{resize:vertical;min-height:70px}
.field input:focus-visible,.field select:focus-visible,.field textarea:focus-visible{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent)}
.field-error{color:var(--red);font-size:11px;margin:6px 0 0}
.foot-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}
.table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
.table th{font-size:11px;white-space:nowrap;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--bg);text-align:left;padding:12px 11px;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:1}
.table td{font-size:12px;color:var(--text);padding:12px 11px;border-bottom:1px solid var(--line);vertical-align:middle}
.table tbody tr{transition:background var(--t-fast) var(--ease)}
.table tbody tr:hover{background:var(--lav)}.table strong{color:var(--ink)}
.badge{display:inline-flex;align-items:center;gap:6px;border-radius:7px;font-weight:760;font-size:11px;padding:6px 8px;white-space:nowrap}
.badge:before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}
.badge.pendiente{color:var(--muted);background:var(--bg)}
.badge.activa{color:var(--primary);background:var(--lav)}
.badge.revision{color:var(--orange);background:var(--orangelight)}
.badge.completada{color:var(--green);background:var(--greenlight)}
.badge.bloqueada{color:var(--red);background:var(--redlight)}
.badge.cancelada{color:var(--muted);background:var(--bg);text-decoration:line-through}
.badge.critica{color:var(--red);background:var(--redlight)}
.badge.alta{color:var(--orange);background:var(--orangelight)}
.badge.media{color:var(--blue);background:var(--bluelight)}
.badge.baja{color:var(--green);background:var(--greenlight)}
.badge.admin{background:var(--lav);color:var(--primary)}
.badge.usuario{background:var(--bluelight);color:var(--blue)}
.badge.off{background:var(--redlight);color:var(--red)}
.project-card{padding:20px;display:flex;flex-direction:column;min-height:200px;cursor:pointer;border-left:3px solid var(--line);transition:border-color var(--duration-fast) var(--ease-standard),transform var(--duration-fast) var(--ease-standard)}
.project-card:hover{border-color:var(--accent);transform:translateY(-1px)}
.project-card.risk-ok{border-left-color:var(--primary)}
.project-card.risk-risk{border-left-color:var(--orange)}
.project-card.risk-done{border-left-color:var(--green)}
.project-card-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.project-card-top-right{display:flex;align-items:center;gap:8px}
.progress-ring{flex:0 0 auto}
.project-card h2{font-size:18px;margin:4px 0 5px}
.project-card p{line-height:1.55;color:var(--muted);font-size:12px;min-height:34px;margin:0 0 16px}
.project-card .meta{display:flex;gap:12px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin:0 0 14px}
.bar-row{display:flex;align-items:center;gap:8px}
.bar-row .bar{flex:1;margin-bottom:0}
.bar-pct{font-size:11px;font-weight:760;color:var(--muted);font-variant-numeric:tabular-nums;flex:0 0 auto}
.avatar-stack{display:flex;margin-top:12px}
.avatar-chip{width:26px;height:26px;border-radius:999px;background:var(--lav);color:var(--primary);display:grid;place-items:center;font-size:10px;font-weight:800;border:2px solid var(--paper);margin-left:-8px}
.avatar-stack .avatar-chip:first-child{margin-left:0}
.avatar-more{background:var(--line);color:var(--text)}
.flag{background:var(--lav);color:var(--primary);font-weight:760;border-radius:6px;padding:5px 7px;font-size:11px}
.bar{height:9px;background:var(--line);border-radius:99px;overflow:hidden;margin-bottom:8px}
.bar span{height:100%;display:block;background:linear-gradient(90deg,var(--accent),var(--primary));border-radius:99px;transition:width 700ms var(--ease)}
.bar span.threshold-ok{background:var(--green)}
.bar span.threshold-warn{background:var(--orange)}
.bar span.threshold-over{background:var(--red)}
.load-bar{min-width:140px}
.load-bar .bar{margin-bottom:4px}
.load-bar small{color:var(--muted);font-size:11px;font-variant-numeric:tabular-nums}
.stacked-bar{display:flex;height:10px;border-radius:99px;overflow:hidden;background:var(--line);margin-bottom:10px}
.stacked-bar .seg{height:100%;transition:width 700ms var(--ease)}
.seg-red{background:var(--red)}.seg-orange{background:var(--orange)}.seg-primary{background:var(--primary)}.seg-green{background:var(--green)}
.stacked-bar-legend{display:flex;gap:16px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-bottom:17px}
.stacked-bar-legend .dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:5px}
.dot-red{background:var(--red)}.dot-orange{background:var(--orange)}.dot-primary{background:var(--primary)}.dot-green{background:var(--green)}
.chart-row{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.chart-wrap{position:relative;height:220px}
.chart-wrap-donut{height:200px}
.hbar-list{display:flex;flex-direction:column;gap:9px}
.hbar-row{display:grid;grid-template-columns:160px 1fr 46px;align-items:center;gap:10px;font-size:12px}
.hbar-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text)}
.hbar-label:hover{color:var(--primary)}
.hbar-track{height:8px;background:var(--line);border-radius:99px;overflow:hidden}
.hbar-track span{height:100%;display:block;background:var(--accent);border-radius:99px;transition:width 700ms var(--ease)}
.hbar-value{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums;font-size:11px}
.heatmap-table td.heatmap-cell{text-align:center;font-variant-numeric:tabular-nums;background:color-mix(in srgb, var(--accent) var(--heat,0%), var(--paper))}
.project-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:15px}
.filters{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.filters a{padding:7px 13px;border-radius:999px;border:1px solid var(--line);font-size:12px;color:var(--text)}
.filters a.on{background:var(--primary);border-color:var(--primary);color:var(--primary-text)}
.topbar-side{display:flex;flex-direction:column;align-items:flex-end;gap:10px}
.drawer{position:fixed;inset:0;z-index:70;visibility:hidden;pointer-events:none}
.drawer.open{visibility:visible;pointer-events:auto}
.drawer-backdrop{position:absolute;inset:0;background:rgba(10,20,25,.5);opacity:0;transition:opacity var(--t-base) var(--ease)}
.drawer.open .drawer-backdrop{opacity:1}
.drawer-panel{position:absolute;top:0;right:0;height:100%;width:min(460px,92vw);background:var(--paper);box-shadow:var(--shadow-2);display:flex;flex-direction:column;transform:translateX(100%);transition:transform var(--t-base) var(--ease)}
.drawer.open .drawer-panel{transform:translateX(0)}
.drawer-header{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--line);flex:0 0 auto}
.drawer-header h2{margin:0;font-size:16px}
.drawer-close{background:transparent;border:0;font-size:22px;line-height:1;color:var(--muted);padding:2px 8px;border-radius:8px}
.drawer-close:hover{background:var(--lav)}
.drawer-body{padding:18px 20px;overflow-y:auto;flex:1;display:flex;flex-direction:column;gap:20px}
.drawer-section h3{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:0 0 10px;font-weight:760}
.people-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.person-chip{position:relative;border:1px solid var(--line);border-radius:var(--radius-control);padding:8px 10px;display:flex;gap:8px;align-items:center;font-size:12px;cursor:pointer;transition:background var(--t-fast) var(--ease),border-color var(--t-fast) var(--ease)}
.person-chip input{position:absolute;opacity:0;width:0;height:0}
.person-chip:has(input:checked){background:var(--lav);border-color:var(--primary)}
.chip-avatar{width:22px;height:22px;border-radius:999px;background:var(--lav);color:var(--primary);display:grid;place-items:center;font-size:10px;font-weight:800;flex:0 0 auto}
.kebab{position:relative;display:inline-block}
.btn-icon{background:transparent;border:1px solid transparent;color:var(--text);font-size:16px;line-height:1;padding:6px 10px;border-radius:var(--radius-control)}
.btn-icon:hover{background:var(--lav);border-color:var(--line)}
.row-menu{display:none;position:absolute;right:0;top:calc(100% + 4px);min-width:150px;background:var(--paper);border:1px solid var(--border);border-radius:var(--radius-control);box-shadow:var(--shadow-2);z-index:5;overflow:hidden}
.row-menu.open{display:block}
.row-menu-item{display:block;width:100%;text-align:left;background:transparent;border:0;padding:9px 12px;font-size:12px;color:var(--text)}
.row-menu-item:hover{background:var(--lav)}
.row-menu-item-danger{color:var(--red)}
.modal{position:fixed;inset:0;z-index:80;visibility:hidden;pointer-events:none;display:grid;place-items:center;padding:16px}
.modal.open{visibility:visible;pointer-events:auto}
.modal-backdrop{position:absolute;inset:0;background:rgba(10,20,25,.5);opacity:0;transition:opacity var(--t-base) var(--ease)}
.modal.open .modal-backdrop{opacity:1}
.modal-panel{position:relative;background:var(--paper);border-radius:var(--radius-card);box-shadow:var(--shadow-2);padding:22px;width:100%;max-width:400px;transform:translateY(8px) scale(.98);opacity:0;transition:transform var(--t-base) var(--ease),opacity var(--t-base) var(--ease)}
.modal.open .modal-panel{transform:translateY(0) scale(1);opacity:1}
.modal-panel h3{margin:0 0 10px;font-size:15px}
.modal-panel p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}
.week-board{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;align-items:start;margin-bottom:20px}
.week-day{background:var(--paper);border:1px solid var(--border);border-radius:var(--radius-card);box-shadow:var(--shadow-1);padding:14px}
.week-day.is-today{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),var(--shadow-1)}
.week-day.is-empty{background:transparent;border-color:transparent;box-shadow:none;padding:14px 4px}
.week-day-head{font-size:11px;font-weight:760;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:8px}
.week-load{height:4px;border-radius:99px;background:var(--line);overflow:hidden;margin-bottom:10px}
.week-load span{height:100%;display:block;background:var(--accent);border-radius:99px;transition:width 700ms var(--ease)}
.week-day.is-today .week-day-head{color:var(--accent)}
.week-day-empty{color:var(--muted);font-size:11px;margin:0}
.week-task{display:flex;align-items:center;gap:7px;padding:7px 0;border-top:1px solid var(--line);font-size:12px}
.week-task:first-of-type{border-top:0}
.week-task-dot{width:7px;height:7px;border-radius:50%;flex:0 0 auto;background:currentColor}
.week-task-dot.critica{color:var(--red)}.week-task-dot.alta{color:var(--orange)}.week-task-dot.media{color:var(--blue)}.week-task-dot.baja{color:var(--green)}
.week-task-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.empty{padding:36px 20px;text-align:center;color:var(--muted);font-size:12px}
.empty-state{padding:40px 20px;text-align:center;color:var(--muted);font-size:12px;display:flex;flex-direction:column;align-items:center;gap:10px}
.empty-state svg{opacity:.5}
.empty-state p{margin:0;max-width:320px;line-height:1.55}
.empty-state .btn{margin-top:2px}
.error{color:var(--red);background:var(--redlight);border-radius:8px;padding:10px;margin-bottom:12px;font-size:12px}
.info{background:var(--lav);border:1px solid var(--line);border-radius:12px;color:var(--primary);padding:13px;font-size:12px;line-height:1.7}
.detail-row{display:flex;justify-content:space-between;gap:10px;padding:11px 0;border-top:1px solid var(--line);font-size:12px}
.detail-row span{color:var(--muted)}
.detail-row:first-child{border-top:0}
.usergrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.usercheck{border:1px solid var(--line);border-radius:var(--radius-control);padding:10px;display:flex;gap:8px;align-items:center;font-size:12px}
.usercheck input{width:auto;min-height:auto}
.kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:17px}
.kpi{padding:19px 19px 17px}
.kpi small{font-size:11px;color:var(--muted)}
.kpi strong{display:block;font-size:26px;font-weight:820;letter-spacing:-.04em;margin:13px 0 8px;font-variant-numeric:tabular-nums}
.kpi p{font-size:12px;color:var(--muted);margin:0}
.kpi-icon{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:10px;background:var(--lav);color:var(--primary);margin-bottom:10px}
.kpi-positive .kpi-icon{background:var(--greenlight);color:var(--green)}
.kpi-positive strong{color:var(--green)}
.feed{display:flex;gap:12px;border-bottom:1px solid var(--line);padding:13px 0}
.feed:last-child{border-bottom:0}
.feed .dot{width:31px;height:31px;border-radius:10px;background:var(--lav);color:var(--primary);display:grid;place-items:center;flex:0 0 auto;font-size:13px;font-weight:800}
.feed strong{font-size:12px;display:block;margin-bottom:5px}
.feed p{font-size:12px;color:var(--muted);margin:0;line-height:1.55}
.auth-shell{min-height:100vh;display:grid;place-items:center;padding:20px}
.auth-card{width:100%;max-width:360px}
.auth-card h1{font-size:16px;margin:0 0 20px}
.table-wrap{width:100%;overflow-x:auto}
