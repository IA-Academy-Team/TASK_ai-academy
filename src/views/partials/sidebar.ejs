<button type="button" class="navtoggle" aria-label="Abrir menú" onclick="document.querySelector('.sidebar').classList.toggle('open')">&#9776;</button>
<nav class="sidebar">
  <button type="button" class="brand" aria-label="Expandir o contraer el menú" onclick="(function(){var s=document.querySelector('.sidebar');if(window.matchMedia('(max-width:750px)').matches){s.classList.toggle('open');return}var h=document.documentElement;var next=h.getAttribute('data-sidebar')==='expanded'?'collapsed':'expanded';h.setAttribute('data-sidebar',next);try{localStorage.setItem('aiacademy-sidebar',next)}catch(e){}})()">
    <img class="brandmark" src="/static/brand/logo.png" alt="Task" />
    <h2>Task</h2>
  </button>

  <div class="navgroup">
    <span class="navlabel">Trabajo</span>
    <a class="navbtn <%= active === 'inicio' ? 'on' : '' %>" href="/" aria-label="Dashboard"><%- include('./icon', { kind: 'home', size: 16 }) %><span class="navbtn-label">Dashboard</span></a>
    <a class="navbtn <%= active === 'proyectos' ? 'on' : '' %>" href="/proyectos" aria-label="Proyectos"><%- include('./icon', { kind: 'folder', size: 16 }) %><span class="navbtn-label">Proyectos</span></a>
    <a class="navbtn <%= active === 'plan-semanal' ? 'on' : '' %>" href="/planeacion" aria-label="Plan semanal"><%- include('./icon', { kind: 'calendar', size: 16 }) %><span class="navbtn-label">Plan semanal</span></a>
    <a class="navbtn <%= active === 'mis-tareas' ? 'on' : '' %>" href="/mis-tareas" aria-label="Mis tareas"><%- include('./icon', { kind: 'check', size: 16 }) %><span class="navbtn-label">Mis tareas</span></a>
  </div>

  <div class="navgroup">
    <span class="navlabel">Equipo</span>
    <a class="navbtn <%= active === 'equipo' ? 'on' : '' %>" href="/equipo" aria-label="Equipo y cargas"><%- include('./icon', { kind: 'users', size: 16 }) %><span class="navbtn-label">Equipo y cargas</span></a>
    <a class="navbtn <%= active === 'solicitudes' ? 'on' : '' %>" href="/solicitudes" aria-label="Solicitudes de apoyo">
      <%- include('./icon', { kind: 'handshake', size: 16 }) %><span class="navbtn-label">Solicitudes de apoyo</span>
      <% if (typeof sidebarCounts !== 'undefined' && sidebarCounts && sidebarCounts.supports > 0) { %><span class="navcount"><%= sidebarCounts.supports %></span><% } %>
    </a>
  </div>

  <% if (user.role === "admin") { %>
  <div class="navgroup">
    <span class="navlabel">Admin</span>
    <a class="navbtn <%= active === 'usuarios' ? 'on' : '' %>" href="/admin/usuarios" aria-label="Administración"><%- include('./icon', { kind: 'shield', size: 16 }) %><span class="navbtn-label">Administración</span></a>
  </div>
  <% } %>

  <div class="sidebar-bottom">
    <a class="sidebar-user" href="/perfil" aria-label="Mi perfil — <%= user.name || user.email %>">
      <span class="sidebar-avatar" style="background:<%= user.color || '#7346CC' %>"><%= (user.name || user.email || "?").charAt(0).toUpperCase() %></span>
      <span class="sidebar-user-name"><%= user.name || user.email %></span>
    </a>
    <button type="button" class="navbtn" aria-label="Salir" onclick="aiacademySignOut(this)"><%- include('./icon', { kind: 'logout', size: 16 }) %><span class="navbtn-label">Salir</span></button>
  </div>
</nav>
<div class="sidebar-backdrop" onclick="document.querySelector('.sidebar').classList.remove('open')"></div>
<script>
function getToastStack() {
  var el = document.getElementById('toast-stack');
  if (!el) {
    el = document.createElement('div');
    el.id = 'toast-stack';
    el.className = 'toast-stack';
    document.body.appendChild(el);
  }
  return el;
}

function dismissToast(toast) {
  if (toast.classList.contains('leaving')) return;
  toast.classList.add('leaving');
  toast.addEventListener('transitionend', function handler(e) {
    if (e.propertyName !== 'opacity') return;
    toast.removeEventListener('transitionend', handler);
    toast.remove();
  });
}

function showErrorAlert(title, message) {
  var toast = document.createElement('div');
  toast.className = 'toast-alert';

  var close = document.createElement('button');
  close.type = 'button';
  close.className = 'toast-alert-close';
  close.setAttribute('aria-label', 'Cerrar');
  close.textContent = '×';
  close.onclick = function () { dismissToast(toast); };

  var titleEl = document.createElement('strong');
  titleEl.textContent = title;

  var body = document.createElement('p');
  body.textContent = message;

  toast.appendChild(close);
  toast.appendChild(titleEl);
  toast.appendChild(body);
  getToastStack().appendChild(toast);
  setTimeout(function () { dismissToast(toast); }, 12000);
}

function aiacademySignOut(button) {
  button.disabled = true;
  fetch('/api/auth/sign-out', { method: 'POST' })
    .then(function (res) {
      if (!res.ok) {
        throw new Error('sign-out failed with status ' + res.status);
      }
      location.href = '/login';
    })
    .catch(function () {
      button.disabled = false;
      showErrorAlert('No se pudo cerrar sesión', 'Intentá de nuevo. Si el problema sigue, recargá la página.');
    });
}

(function () {
  if (!window.EventSource) return;

  function showSupportAlert(data) {
    var toast = document.createElement('div');
    toast.className = 'toast-alert';

    var close = document.createElement('button');
    close.type = 'button';
    close.className = 'toast-alert-close';
    close.setAttribute('aria-label', 'Cerrar');
    close.textContent = '×';
    close.onclick = function () { dismissToast(toast); };

    var title = document.createElement('strong');
    title.textContent = 'Nueva solicitud de apoyo';

    var body = document.createElement('p');
    body.textContent = (data.requestedByName || 'Alguien') + ' te pidió apoyo en "' + data.taskTitle + '" (' + data.projectName + ')';

    var link = document.createElement('a');
    link.className = 'toast-alert-link';
    link.href = '/tareas/' + encodeURIComponent(data.taskId);
    link.textContent = 'Ver tarea';

    toast.appendChild(close);
    toast.appendChild(title);
    toast.appendChild(body);
    toast.appendChild(link);
    getToastStack().appendChild(toast);
    setTimeout(function () { dismissToast(toast); }, 12000);
  }

  var stream = new EventSource('/notificaciones/stream');
  stream.addEventListener('support-request', function (e) {
    showSupportAlert(JSON.parse(e.data));
  });
})();
</script>
