<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Productividad</title>
<%- include('partials/theme-init') %>
<%- include('partials/styles') %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'productividad', user }) %>
  <main class="content">
    <%- include('partials/navbar', { active: 'productividad', actions: [{ label: 'Exportar CSV', href: '/productividad/export.csv?rango=' + rango, variant: 'subtle' }] }) %>
    <div class="topbar">
      <div>
        <h1 class="page-title">Productividad</h1>
        <p class="subtitle"><%= range.from %> a <%= range.to %></p>
      </div>
    </div>

    <div class="filters">
      <% ['dia','semana','mes'].forEach(function(r) { %>
      <a href="/productividad?rango=<%= r %>" class="<%= rango === r ? 'on' : '' %>"><%= r %></a>
      <% }) %>
    </div>

    <div class="kpi-row">
      <div class="card kpi"><small>Horas registradas</small><strong><%= totalHours %></strong></div>
      <div class="card kpi"><small>Proyectos con actividad</small><strong><%= byProject.length %></strong></div>
      <div class="card kpi"><small>Tareas con registro</small><strong><%= tasksWithHours %></strong></div>
      <div class="card kpi"><small>Colaboradores con horas</small><strong><%= byCollaborator.length %></strong></div>
    </div>

    <div class="kpi-row">
      <div class="card kpi"><small>Presupuesto (tareas aprobadas)</small><strong><%= totalEstimate.toFixed(1) %> h</strong></div>
      <div class="card kpi"><small>Horas reales (tareas aprobadas)</small><strong><%= totalActual.toFixed(1) %> h</strong></div>
      <div class="card kpi <%= compliance !== null && compliance >= 80 ? 'kpi-positive' : '' %>"><small>Cumplimiento de presupuesto</small><strong><%= compliance === null ? '—' : compliance + '%' %></strong></div>
      <div class="card kpi"><small>Diferencia real vs. estimado</small><strong><%= (variance >= 0 ? '+' : '') + variance.toFixed(1) %> h</strong></div>
    </div>

    <section class="card pad">
      <div class="sectiontitle"><h2>Horas por día</h2></div>
      <% if (!dailyChart.values.some(function(v) { return v > 0; })) { %>
      <%- include('partials/empty-state', { text: 'Sin horas registradas en el período.' }) %>
      <% } else { %>
      <div class="chart-wrap"><canvas id="chart-daily" role="img" aria-label="Horas registradas por día"></canvas></div>
      <% } %>
    </section>

    <section class="card pad">
      <div class="sectiontitle"><h2>Horas por proyecto</h2></div>
      <% if (byProject.length === 0) { %>
      <%- include('partials/empty-state', { text: 'Sin horas registradas en el período.' }) %>
      <% } else { %>
      <div class="chart-wrap"><canvas id="chart-byproject" role="img" aria-label="Horas registradas por proyecto"></canvas></div>
      <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Proyecto</th><th>Horas</th></tr></thead>
        <tbody>
          <% byProject.forEach(function(p) { %>
          <tr><td><%= p.projectName %></td><td><%= p.hours %></td></tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </section>

    <section class="card pad">
      <div class="sectiontitle"><h2>Top 10 tareas por horas</h2></div>
      <% if (topTasks.length === 0) { %>
      <%- include('partials/empty-state', { text: 'Sin tareas con horas en el período.' }) %>
      <% } else { %>
      <% var maxTaskHours = Math.max.apply(null, topTasks.map(function (t) { return t.hours; })); %>
      <div class="hbar-list">
        <% topTasks.forEach(function(t) { %>
        <div class="hbar-row">
          <a class="hbar-label" href="/tareas/<%= t.taskId %>"><%= t.title %></a>
          <div class="hbar-track"><span style="width: <%= maxTaskHours ? Math.round(t.hours / maxTaskHours * 100) : 0 %>%"></span></div>
          <span class="hbar-value"><%= t.hours %> h</span>
        </div>
        <% }) %>
      </div>
      <% } %>
    </section>

    <section class="card pad">
      <div class="sectiontitle"><h2>Horas por colaborador</h2></div>
      <% if (byCollaborator.length === 0) { %>
      <%- include('partials/empty-state', { text: 'Sin horas registradas en el período.' }) %>
      <% } else { %>
      <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Colaborador</th><th>Horas</th></tr></thead>
        <tbody>
          <% byCollaborator.forEach(function(c) { %>
          <tr><td><%= c.name %></td><td><%= c.hours %></td></tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </section>

    <section class="card pad">
      <div class="sectiontitle"><h2>Carga por persona y día</h2></div>
      <% if (heatmap.rows.length === 0) { %>
      <%- include('partials/empty-state', { text: 'Sin horas registradas en el período.' }) %>
      <% } else { %>
      <div class="table-wrap">
      <table class="table heatmap-table">
        <thead><tr><th>Persona</th><% heatmap.days.forEach(function(d) { %><th><%= d.slice(5) %></th><% }) %></tr></thead>
        <tbody>
          <% heatmap.rows.forEach(function(r) { %>
          <tr>
            <td><%= r.name %></td>
            <% r.cells.forEach(function(h) { %>
            <% var heat = heatmap.maxHours > 0 ? Math.round(h / heatmap.maxHours * 100) : 0; %>
            <td class="heatmap-cell" style="--heat: <%= heat %>%" title="<%= h %> h"><%= h > 0 ? h : '' %></td>
            <% }) %>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </section>

    <section class="card pad">
      <div class="sectiontitle"><h2>Estimado vs. real (tareas aprobadas)</h2></div>
      <% if (estimateVsReal.length === 0) { %>
      <%- include('partials/empty-state', { text: 'Todavía no hay tareas aprobadas.' }) %>
      <% } else { %>
      <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Tarea</th><th>Estimado</th><th>Real</th><th>Desvío</th></tr></thead>
        <tbody>
          <% estimateVsReal.forEach(function(t) { %>
          <tr>
            <td><a href="/tareas/<%= t.taskId %>"><%= t.title %></a></td>
            <td><%= t.estimate %></td>
            <td><%= t.actual %></td>
            <td><%= (t.actual - t.estimate).toFixed(1) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </section>
  </main>
</div>
<script src="/static/vendor/chart.js"></script>
<script src="/static/js/charts.js"></script>
<script>
(function () {
  if (!window.AIAcademyCharts) return;
  var dailyCanvas = document.getElementById('chart-daily');
  if (dailyCanvas) {
    window.AIAcademyCharts.areaSeries(
      dailyCanvas,
      <%- JSON.stringify(dailyChart.labels) %>,
      <%- JSON.stringify(dailyChart.values) %>
    );
  }
  var byProjectCanvas = document.getElementById('chart-byproject');
  if (byProjectCanvas) {
    window.AIAcademyCharts.barByCategory(
      byProjectCanvas,
      <%- JSON.stringify(byProject.map(function(p) { return p.projectName; })).replace(/</g, '\\u003c') %>,
      <%- JSON.stringify(byProject.map(function(p) { return p.hours; })) %>
    );
  }
})();
</script>
</body>
</html>
