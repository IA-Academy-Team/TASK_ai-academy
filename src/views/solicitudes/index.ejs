<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Solicitudes de apoyo</title>
<%- include('../partials/theme-init') %>
<%- include('../partials/styles') %>
<style>
.support-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}.support-kpi{padding:19px;min-height:120px}.support-kpi small{font-size:11px;color:var(--muted)}.support-kpi strong{display:block;font-size:27px;margin:14px 0 8px}.support-kpi p{margin:0;font-size:10px;color:var(--muted)}.support-registered{padding:20px;margin-top:16px}.support-registered-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:16px}.support-registered-head h2{margin:0;font-size:15px}.support-registered-head p{margin:0;font-size:11px;color:var(--muted)}.support-request-row{display:flex;align-items:center;gap:13px;padding:16px;border:1px solid var(--line);border-radius:var(--radius-control);margin-top:10px}.support-request-avatar{width:38px;height:38px;border-radius:999px;display:grid;place-items:center;background:var(--lav);color:var(--primary);font-size:12px;font-weight:800}.support-request-body{min-width:0;flex:1}.support-request-body strong,.support-request-body span{display:block}.support-request-body strong{font-size:13px}.support-request-body span{margin-top:5px;color:var(--muted);font-size:11px}.support-request-actions{display:flex;gap:8px;flex:0 0 auto}.support-hours-note{margin-top:16px;padding:15px;border:1px solid var(--line);border-radius:var(--radius-control);background:var(--lav);color:var(--primary);font-size:12px;line-height:1.55}@media(max-width:800px){.support-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.support-request-row{align-items:flex-start;flex-wrap:wrap}.support-request-actions{width:100%}}@media(max-width:520px){.support-kpis{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="app">
  <%- include('../partials/sidebar', { active: 'solicitudes', user }) %>
  <main class="content">
    <%- include('../partials/navbar', { active: 'solicitudes' }) %>
    <div class="topbar">
      <div>
        <h1 class="page-title">Solicitudes de apoyo</h1>
        <p class="subtitle">Puedes invitar a un colaborador para que acepte o pedir al líder que asigne apoyo. El responsable principal no cambia.</p>
      </div>
    </div>

    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <section class="support-kpis"><article class="card support-kpi"><small>Solicitudes visibles</small><strong><%= visibleCount %></strong><p>De proyectos a los que perteneces</p></article><article class="card support-kpi"><small>Por resolver por mí</small><strong><%= pendingCount %></strong><p>Requieren aceptación o asignación</p></article><article class="card support-kpi"><small>Aceptadas</small><strong><%= acceptedCount %></strong><p>Apoyos confirmados</p></article><article class="card support-kpi"><small>Rechazadas</small><strong><%= rejectedCount %></strong><p>Sin asignación de apoyo</p></article></section>

    <section class="card pad">
      <div class="sectiontitle"><h2>Nueva solicitud</h2></div>
      <% if (requestable.length === 0) { %>
      <%- include('../partials/empty-state', { text: 'No tienes tareas para las que puedas pedir apoyo.' }) %>
      <% } else { %>
      <form method="post" id="nueva-solicitud-form" class="form-grid" onsubmit="return Boolean(document.getElementById('solicitud-task').value)">
        <div class="field"><label>Proyecto *</label>
          <select id="solicitud-project" required onchange="onSolicitudProjectChange()">
            <option value="">Elige un proyecto</option>
          </select>
        </div>
        <div class="field"><label>Tarea *</label>
          <select id="solicitud-task" required onchange="onSolicitudTaskChange()" disabled>
            <option value="">Elige primero un proyecto</option>
          </select>
        </div>
        <div class="field"><label>Persona *</label>
          <select name="targetUserId" id="solicitud-user" required disabled>
            <option value="">Elige primero una tarea</option>
          </select>
        </div>
        <div class="field"><label>Modalidad *</label>
          <select name="mode" required>
            <option value="invite">Invitar (la persona acepta)</option>
            <option value="apply">Pedir que el líder la asigne</option>
          </select>
        </div>
        <div class="field full"><label>Motivo</label><input name="reason" maxlength="1000" /></div>
        <div class="foot-actions full"><button type="submit" class="btn primary">Pedir apoyo</button></div>
      </form>
      <script id="solicitud-requestable-data" type="application/json"><%- JSON.stringify(requestable).replace(/</g, '\\u003c') %></script>
      <script id="solicitud-users-data" type="application/json"><%- JSON.stringify(allUsers.map(function(u){ return { id: u.id, name: u.name }; })).replace(/</g, '\\u003c') %></script>
      <script>
      (function () {
        var requestable = JSON.parse(document.getElementById('solicitud-requestable-data').textContent);
        var allUsers = JSON.parse(document.getElementById('solicitud-users-data').textContent);
        var projectSelect = document.getElementById('solicitud-project');
        var taskSelect = document.getElementById('solicitud-task');
        var userSelect = document.getElementById('solicitud-user');
        var form = document.getElementById('nueva-solicitud-form');

        var INDEPENDENT_GROUP = '__independent__';
        var projects = [];
        var seen = {};
        requestable.forEach(function (t) {
          var pid = t.projectId || INDEPENDENT_GROUP;
          if (!seen[pid]) {
            seen[pid] = true;
            projects.push({
              id: pid,
              label: t.projectId ? (t.projectCode + ' — ' + t.projectName) : 'Tareas independientes',
            });
          }
        });
        projects.forEach(function (p) {
          var opt = document.createElement('option');
          opt.value = p.id;
          opt.textContent = p.label;
          projectSelect.appendChild(opt);
        });

        window.onSolicitudProjectChange = function () {
          taskSelect.innerHTML = '';
          userSelect.innerHTML = '';
          var placeholder = document.createElement('option');
          placeholder.value = '';
          var tasks = requestable.filter(function (t) { return (t.projectId || INDEPENDENT_GROUP) === projectSelect.value; });
          if (!projectSelect.value || tasks.length === 0) {
            placeholder.textContent = 'Elige primero un proyecto';
            taskSelect.appendChild(placeholder);
            taskSelect.disabled = true;
            userSelect.innerHTML = '<option value="">Elige primero una tarea</option>';
            userSelect.disabled = true;
            form.action = '';
            return;
          }
          placeholder.textContent = 'Elige una tarea';
          taskSelect.appendChild(placeholder);
          tasks.forEach(function (t) {
            var opt = document.createElement('option');
            opt.value = t.id;
            opt.textContent = t.title + ' (responsable: ' + t.ownerName + ')';
            opt.dataset.ownerId = t.ownerId;
            taskSelect.appendChild(opt);
          });
          taskSelect.disabled = false;
          userSelect.innerHTML = '<option value="">Elige primero una tarea</option>';
          userSelect.disabled = true;
          form.action = '';
        };

        window.onSolicitudTaskChange = function () {
          var taskId = taskSelect.value;
          userSelect.innerHTML = '';
          if (!taskId) {
            userSelect.innerHTML = '<option value="">Elige primero una tarea</option>';
            userSelect.disabled = true;
            form.action = '';
            return;
          }
          var ownerId = taskSelect.options[taskSelect.selectedIndex].dataset.ownerId;
          var placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.textContent = 'Elige una persona';
          userSelect.appendChild(placeholder);
          allUsers.filter(function (u) { return u.id !== ownerId; }).forEach(function (u) {
            var opt = document.createElement('option');
            opt.value = u.id;
            opt.textContent = u.name;
            userSelect.appendChild(opt);
          });
          userSelect.disabled = false;
          form.action = '/tareas/' + taskId + '/apoyo';
        };
      })();
      </script>
      <% } %>
    </section>

    <section class="card support-registered">
      <div class="support-registered-head"><h2>Solicitudes registradas</h2><p>Selecciona una tarea para gestionar apoyos</p></div>
      <% if (forMe.length === 0) { %>
      <%- include('../partials/empty-state', { text: 'No tienes solicitudes pendientes.' }) %>
      <% } else { %>
      <% forMe.forEach(function(row) { %><article class="support-request-row"><span class="support-request-avatar"><%= (row.requestedByName || '?').charAt(0).toUpperCase() %></span><div class="support-request-body"><strong><%= row.taskTitle %> · <%= row.projectName || 'Independiente' %></strong><span>Solicita: <%= row.requestedByName || row.request.requestedBy %> · <%= row.request.reason || 'Sin motivo adicional' %></span></div><div class="support-request-actions"><a class="btn subtle" href="/tareas/<%= row.request.taskId %>">Ver tarea</a><form method="post" action="/solicitudes/<%= row.request.id %>/aceptar"><button class="btn primary" type="submit">Aceptar</button></form><form method="post" action="/solicitudes/<%= row.request.id %>/rechazar"><button class="btn danger" type="submit">Rechazar</button></form></div></article><% }) %>
      <% } %>
    </section>

    <% if (forLeader.length > 0) { %>
    <section class="card pad">
      <div class="sectiontitle"><h2>Para resolver como líder</h2></div>
      <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Tarea</th><th>Proyecto</th><th>Pide</th><th>Motivo</th><th></th></tr></thead>
        <tbody>
          <% forLeader.forEach(function(row) { %>
          <tr>
            <td><a href="/tareas/<%= row.request.taskId %>"><%= row.taskTitle %></a></td>
            <td><%= row.projectName || "Independiente" %></td>
            <td><%= row.requestedByName || row.request.requestedBy %></td>
            <td><%= row.request.reason %></td>
            <td style="display:flex;gap:6px">
              <form method="post" action="/solicitudes/<%= row.request.id %>/aceptar"><button class="btn primary" type="submit">Aceptar</button></form>
              <form method="post" action="/solicitudes/<%= row.request.id %>/rechazar"><button class="btn danger" type="submit">Rechazar</button></form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </section>
    <% } %>
    <p class="support-hours-note">Los apoyos pueden declarar sus propias horas. El resultado final suma horas del responsable y horas de apoyo por persona, sin duplicar registros.</p>
  </main>
</div>
</body>
</html>
