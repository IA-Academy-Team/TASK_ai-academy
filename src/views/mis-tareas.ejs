<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Mis tareas</title>
<%- include('partials/theme-init') %>
<%- include('partials/styles') %>
<style>
.my-task-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}.my-task-kpi{min-height:120px;padding:19px}.my-task-kpi small{color:var(--muted);font-size:11px}.my-task-kpi strong{display:block;margin:14px 0 8px;font-size:27px;line-height:1}.my-task-kpi p{margin:0;color:var(--muted);font-size:10px}.my-task-panel{padding:20px;margin:0}.my-task-panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:15px}.my-task-panel-head h2{margin:0;font-size:15px}.my-task-panel-head p{margin:0;color:var(--muted);font-size:10.5px}.my-task-filter-box{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;padding:14px;border:1px solid var(--line);border-radius:var(--radius-control);background:var(--bg);margin-bottom:16px}.my-task-filter-label{display:block;margin:0 0 7px;font-size:10px;font-weight:800;color:var(--muted);letter-spacing:.04em;text-transform:uppercase}.my-task-filters{display:flex;flex-wrap:wrap;gap:7px}.my-task-filters a{display:inline-flex;align-items:center;gap:7px;padding:9px 10px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--text);font-size:10px;font-weight:730}.my-task-filters a.on{background:var(--primary);border-color:var(--primary);color:var(--primary-text)}.my-task-filters b{padding:1px 5px;border-radius:5px;background:var(--lav);color:var(--primary);font-size:9px}.my-task-filters a.on b{background:color-mix(in srgb,var(--paper) 24%,transparent);color:var(--primary-text)}.my-task-order{width:180px;flex:0 0 auto}.my-task-order select{min-height:36px;font-size:11px}.my-task-table th{font-size:10px}.my-task-table td{padding-top:13px;padding-bottom:13px}.my-task-title{display:block;font-weight:760;color:var(--ink)}.my-task-deliverable{display:block;margin-top:3px;color:var(--muted);font-size:10px}@media (max-width:900px){.my-task-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.my-task-filter-box{align-items:stretch;flex-direction:column}.my-task-order{width:100%}}@media (max-width:540px){.my-task-kpis{grid-template-columns:1fr}.my-task-panel{padding:16px}.my-task-panel-head{align-items:flex-start;flex-direction:column}}
</style>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'mis-tareas', user }) %>
  <main class="content">
    <%- include('partials/navbar', { active: 'mis-tareas', actions: [{ label: 'Crear tarea propia', href: '/tareas/nueva', icon: 'plus', showLabel: true }] }) %>
    <div class="topbar">
      <div>
        <h1 class="page-title">Mis tareas</h1>
        <p class="subtitle">Responsabilidades de <%= user.name || 'tu cuenta' %>. Aquí puedes iniciar, entregar, solicitar apoyo o abrir cada actividad.</p>
      </div>
    </div>

    <section class="my-task-kpis"><article class="card my-task-kpi"><small>A mi cargo</small><strong><%= total %></strong><p>Responsable único</p></article><article class="card my-task-kpi"><small>En ejecución</small><strong><%= active %></strong><p>Trabajos activos</p></article><article class="card my-task-kpi"><small>Pendientes</small><strong><%= pending %></strong><p>Incluye tareas dependientes</p></article><article class="card my-task-kpi"><small>Apoyos aceptados</small><strong><%= supportCount %></strong><p>No cambian mi responsabilidad</p></article></section>

    <% [
      { id: 'modal-kpi-total', title: 'Total', rows: kpiTotalRows },
      { id: 'modal-kpi-vencidas', title: 'Vencidas', rows: kpiVencidasRows },
      { id: 'modal-kpi-urgentes', title: 'Urgentes', rows: kpiUrgentesRows },
      { id: 'modal-kpi-completadas', title: 'Completadas', rows: kpiCompletadasRows },
    ].forEach(function(m) { %>
    <div class="modal" id="<%= m.id %>">
      <div class="modal-backdrop" onclick="document.getElementById('<%= m.id %>').classList.remove('open')"></div>
      <div class="modal-panel">
        <div class="drawer-header" style="padding:0 0 16px">
          <h2><%= m.title %></h2>
          <button type="button" class="drawer-close" aria-label="Cerrar" onclick="document.getElementById('<%= m.id %>').classList.remove('open')"><%- include('partials/icon', { kind: 'x', size: 18 }) %></button>
        </div>
        <% if (m.rows.length === 0) { %>
        <%- include('partials/empty-state', { text: 'Nada para mostrar.' }) %>
        <% } else { %>
        <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Tarea</th><th>Proyecto</th><th>Estado</th><th>Vence</th></tr></thead>
          <tbody>
            <% m.rows.forEach(function(r) { %>
            <tr onclick="location.href='/tareas/<%= r.id %>'" style="cursor:pointer">
              <td><%= r.title %></td>
              <td><%= r.projectName %></td>
              <td><span class="badge <%= r.status %>"><%= r.status %></span></td>
              <td><%= r.due %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
        <% } %>
      </div>
    </div>
    <% }) %>

    <% var urgTotal = urgencyBuckets.vencidas + urgencyBuckets.urgentes + urgencyBuckets.enCurso + urgencyBuckets.completadas; %>
    <% if (urgTotal > 0) { %>
    <div class="stacked-bar" title="Vencidas <%= urgencyBuckets.vencidas %> · Urgentes <%= urgencyBuckets.urgentes %> · En curso <%= urgencyBuckets.enCurso %> · Completadas <%= urgencyBuckets.completadas %>">
      <% if (urgencyBuckets.vencidas) { %><span class="seg seg-red" style="width: <%= (urgencyBuckets.vencidas / urgTotal * 100).toFixed(2) %>%"></span><% } %>
      <% if (urgencyBuckets.urgentes) { %><span class="seg seg-orange" style="width: <%= (urgencyBuckets.urgentes / urgTotal * 100).toFixed(2) %>%"></span><% } %>
      <% if (urgencyBuckets.enCurso) { %><span class="seg seg-primary" style="width: <%= (urgencyBuckets.enCurso / urgTotal * 100).toFixed(2) %>%"></span><% } %>
      <% if (urgencyBuckets.completadas) { %><span class="seg seg-green" style="width: <%= (urgencyBuckets.completadas / urgTotal * 100).toFixed(2) %>%"></span><% } %>
    </div>
    <div class="stacked-bar-legend">
      <span><i class="dot dot-red"></i>Vencidas <%= urgencyBuckets.vencidas %></span>
      <span><i class="dot dot-orange"></i>Urgentes <%= urgencyBuckets.urgentes %></span>
      <span><i class="dot dot-primary"></i>En curso <%= urgencyBuckets.enCurso %></span>
      <span><i class="dot dot-green"></i>Completadas <%= urgencyBuckets.completadas %></span>
    </div>
    <% } %>

    <section class="card my-task-panel">
      <div class="my-task-panel-head"><h2>Actividades donde soy responsable</h2><p>Haz clic para abrir la ficha de una tarea</p></div>
      <div class="my-task-filter-box">
        <div><span class="my-task-filter-label">Filtrar por estado</span><div class="my-task-filters">
        <% [['todas','Todas',total],['vencidas','Vencidas',vencidas],['urgentes','Urgentes',urgentes],['activa','En ejecución',active],['revision','En validación',review],['pendiente','Pendientes',pending],['bloqueada','Bloqueadas',blocked],['completada','Finalizadas',completadas],['cancelada','Canceladas',cancelled]].forEach(function(f) { %>
        <a href="/mis-tareas?estado=<%= f[0] %>&orden=<%= orden %>" class="<%= estado === f[0] ? 'on' : '' %>"><%= f[1] %> <b><%= f[2] %></b></a>
        <% }) %>
        </div></div>
      <div class="field my-task-order">
        <label class="my-task-filter-label">Ordenar tareas</label>
        <select onchange="location.href='/mis-tareas?estado=<%= estado %>&orden=' + this.value">
          <% [['sequence','Manual'],['due','Vencidas primero'],['priority','Por prioridad']].forEach(function(o) { %>
          <option value="<%= o[0] %>" <%= orden === o[0] ? 'selected' : '' %>><%= o[1] %></option>
          <% }) %>
        </select>
      </div>
      </div>
    </section>

    <section class="card my-task-panel">
      <% if (tasks.length === 0) { %>
      <%- include('partials/empty-state', { text: 'Sin tareas en esta vista.' }) %>
      <% } else { %>
      <div class="table-wrap">
      <table class="table my-task-table">
        <thead><tr><th>Orden</th><th>Tarea / entregable</th><th>Responsable único</th><th>Prioridad</th><th>Horas</th><th>Estado</th><th>Acción</th></tr></thead>
        <tbody>
          <% tasks.forEach(function(r) { %>
          <tr onclick="location.href='/tareas/<%= r.task.id %>'" style="cursor:pointer">
            <td>#<%= r.task.order %></td>
            <td><span class="my-task-title"><%= r.task.title %></span><span class="my-task-deliverable"><%= r.projectName || "Independiente" %> · <%= r.task.deliverable %></span></td>
            <td><%= user.name || user.email %></td>
            <td><span class="badge <%= r.task.priority %>"><%= r.task.priority %></span></td>
            <td><%= r.task.estimate %> h</td>
            <td><span class="badge <%= r.task.status %>"><%= r.task.status %></span></td>
            <td><a class="btn subtle" href="/tareas/<%= r.task.id %>">Abrir</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </section>

    <section class="card pad">
      <div class="sectiontitle"><h2>Tareas donde soy apoyo</h2></div>
      <% if (support.length === 0) { %>
      <%- include('partials/empty-state', { text: 'No eres apoyo de ninguna tarea.' }) %>
      <% } else { %>
      <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Tarea</th><th>Proyecto</th><th>Estado</th><th>Vence</th></tr></thead>
        <tbody>
          <% support.forEach(function(r) { %>
          <tr onclick="location.href='/tareas/<%= r.task.id %>'" style="cursor:pointer">
            <td><%= r.task.title %></td>
            <td><%= r.projectName || "Independiente" %></td>
            <td><span class="badge <%= r.task.status %>"><%= r.task.status %></span></td>
            <td><%= r.task.due %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </section>
  </main>
</div>
</body>
</html>
