<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/static/brand/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/static/brand/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/static/brand/favicon-16x16.png" />
<title>Task by Academy — Mis tareas</title>
<%- include('partials/theme-init') %>
<%- include('partials/styles') %>
</head>
<body>
<div class="app">
  <%- include('partials/sidebar', { active: 'mis-tareas', user }) %>
  <main class="content">
    <%- include('partials/navbar', { active: 'mis-tareas', actions: [{ label: '+ Crear tarea propia', href: '/tareas/nueva' }] }) %>
    <div class="topbar">
      <div>
        <h1 class="page-title">Mis tareas</h1>
        <p class="subtitle">Mostrando <%= showing %> de <%= of %> tareas vigentes</p>
      </div>
    </div>

    <div class="kpi-row">
      <div class="card kpi"><small>Total</small><strong><%= total %></strong></div>
      <div class="card kpi"><small>Vencidas</small><strong><%= vencidas %></strong></div>
      <div class="card kpi"><small>Urgentes</small><strong><%= urgentes %></strong></div>
      <div class="card kpi"><small>Completadas</small><strong><%= completadas %></strong></div>
    </div>

    <% var urgTotal = urgencyBuckets.vencidas + urgencyBuckets.urgentes + urgencyBuckets.enCurso + urgencyBuckets.completadas; %>
    <% if (urgTotal > 0) { %>
    <div class="stacked-bar" title="Vencidas <%= urgencyBuckets.vencidas %> · Urgentes <%= urgencyBuckets.urgentes %> · En curso <%= urgencyBuckets.enCurso %> · Completadas <%= urgencyBuckets.completadas %>">
      <% if (urgencyBuckets.vencidas) { %><span class="seg seg-red" style="width: <%= (urgencyBuckets.vencidas / urgTotal * 100).toFixed(2) %>%"></span><% } %>
      <% if (urgencyBuckets.urgentes) { %><span class="seg seg-orange" style="width: <%= (urgencyBuckets.urgentes / urgTotal * 100).toFixed(2) %>%"></span><% } %>
      <% if (urgencyBuckets.enCurso) { %><span class="seg seg-primary" style="width: <%= (urgencyBuckets.enCurso / urgTotal * 100).toFixed(2) %>%"></span><% } %>
      <% if (urgencyBuckets.completadas) { %><span class="seg seg-green" style="width: <%= (urgencyBuckets.completadas / urgTotal * 100).toFixed(2) %>%"></span><% } %>
    </div>
    <div class="stacked-bar-legend">
      <span><i class="dot dot-red"></i>Vencidas <%= urgencyBuckets.vencidas %></span>
      <span><i class="dot dot-orange"></i>Urgentes <%= urgencyBuckets.urgentes %></span>
      <span><i class="dot dot-primary"></i>En curso <%= urgencyBuckets.enCurso %></span>
      <span><i class="dot dot-green"></i>Completadas <%= urgencyBuckets.completadas %></span>
    </div>
    <% } %>

    <div class="filters">
      <% ['todas','vencidas','urgentes','pendiente','activa','revision','bloqueada','completada','cancelada'].forEach(function(f) { %>
      <a href="/mis-tareas?estado=<%= f %>&orden=<%= orden %>" class="<%= estado === f ? 'on' : '' %>"><%= f %></a>
      <% }) %>
    </div>
    <div class="filters">
      <% [['sequence','Manual'],['due','Vencimiento'],['priority','Prioridad']].forEach(function(o) { %>
      <a href="/mis-tareas?estado=<%= estado %>&orden=<%= o[0] %>" class="<%= orden === o[0] ? 'on' : '' %>">Orden: <%= o[1] %></a>
      <% }) %>
    </div>

    <section class="card pad">
      <% if (tasks.length === 0) { %>
      <%- include('partials/empty-state', { text: 'Sin tareas en esta vista.' }) %>
      <% } else { %>
      <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Tarea</th><th>Proyecto</th><th>Prioridad</th><th>Estado</th><th>Vence</th></tr></thead>
        <tbody>
          <% tasks.forEach(function(r) { %>
          <tr onclick="location.href='/tareas/<%= r.task.id %>'" style="cursor:pointer">
            <td><%= r.task.title %></td>
            <td><%= r.projectName || "Independiente" %></td>
            <td><span class="badge <%= r.task.priority %>"><%= r.task.priority %></span></td>
            <td><span class="badge <%= r.task.status %>"><%= r.task.status %></span></td>
            <td><%= r.task.due %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </section>

    <section class="card pad">
      <div class="sectiontitle"><h2>Tareas donde soy apoyo</h2></div>
      <% if (support.length === 0) { %>
      <%- include('partials/empty-state', { text: 'No eres apoyo de ninguna tarea.' }) %>
      <% } else { %>
      <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Tarea</th><th>Proyecto</th><th>Estado</th><th>Vence</th></tr></thead>
        <tbody>
          <% support.forEach(function(r) { %>
          <tr onclick="location.href='/tareas/<%= r.task.id %>'" style="cursor:pointer">
            <td><%= r.task.title %></td>
            <td><%= r.projectName || "Independiente" %></td>
            <td><span class="badge <%= r.task.status %>"><%= r.task.status %></span></td>
            <td><%= r.task.due %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </section>
  </main>
</div>
</body>
</html>
